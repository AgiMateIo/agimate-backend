<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="002-webhook-registrations" author="agimate">
        <comment>Add webhook_registrations table for event notification subscriptions</comment>

        <createTable tableName="webhook_registrations">
            <column name="id" type="BIGSERIAL">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="pub_id" type="UUID" defaultValueComputed="gen_random_uuid()">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="user_pub_id" type="UUID">
                <constraints nullable="false"/>
            </column>
            <column name="name" type="TEXT">
                <constraints nullable="false"/>
            </column>
            <column name="description" type="TEXT"/>
            <column name="event_type" type="TEXT">
                <constraints nullable="false"/>
            </column>
            <column name="url" type="TEXT">
                <constraints nullable="false"/>
            </column>
            <column name="auth_header" type="TEXT"/>
            <column name="enabled" type="BOOLEAN" defaultValueBoolean="true">
                <constraints nullable="false"/>
            </column>
            <column name="last_triggered_at" type="TIMESTAMP"/>
            <column name="deleted_at" type="TIMESTAMP"/>
            <column name="created_at" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <createIndex tableName="webhook_registrations" indexName="idx_webhook_registrations_user_pub_id">
            <column name="user_pub_id"/>
        </createIndex>

        <createIndex tableName="webhook_registrations" indexName="idx_webhook_registrations_event_type">
            <column name="event_type"/>
        </createIndex>

        <createIndex tableName="webhook_registrations" indexName="idx_webhook_registrations_enabled_deleted">
            <column name="enabled"/>
            <column name="deleted_at"/>
        </createIndex>

        <createIndex tableName="webhook_registrations" indexName="idx_webhook_registrations_user_event_active">
            <column name="user_pub_id"/>
            <column name="event_type"/>
            <column name="deleted_at"/>
        </createIndex>

        <sql>
            CREATE UNIQUE INDEX unq_webhook_user_event_url
            ON webhook_registrations(user_pub_id, event_type, url)
            WHERE deleted_at IS NULL;
        </sql>

        <rollback>
            <dropTable tableName="webhook_registrations"/>
        </rollback>
    </changeSet>

</databaseChangeLog>
