<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="003-webhook-deliveries" author="agimate">
        <comment>Add webhook_deliveries table for tracking webhook HTTP calls</comment>

        <createTable tableName="webhook_deliveries">
            <column name="id" type="BIGSERIAL">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="pub_id" type="UUID" defaultValueComputed="gen_random_uuid()">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="webhook_registration_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="event_type" type="TEXT">
                <constraints nullable="false"/>
            </column>
            <column name="user_pub_id" type="UUID">
                <constraints nullable="false"/>
            </column>
            <column name="credential_id" type="UUID"/>
            <column name="device_id" type="TEXT"/>
            <column name="request_url" type="TEXT">
                <constraints nullable="false"/>
            </column>
            <column name="request_payload" type="JSONB">
                <constraints nullable="false"/>
            </column>
            <column name="response_status_code" type="INTEGER"/>
            <column name="response_body" type="TEXT"/>
            <column name="error_message" type="TEXT"/>
            <column name="duration_ms" type="BIGINT"/>
            <column name="triggered_at" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <addForeignKeyConstraint
                baseTableName="webhook_deliveries"
                baseColumnNames="webhook_registration_id"
                constraintName="fk_webhook_delivery_registration"
                referencedTableName="webhook_registrations"
                referencedColumnNames="id"
                onDelete="CASCADE"/>

        <createIndex tableName="webhook_deliveries" indexName="idx_webhook_deliveries_registration_id">
            <column name="webhook_registration_id"/>
        </createIndex>

        <createIndex tableName="webhook_deliveries" indexName="idx_webhook_deliveries_user_pub_id">
            <column name="user_pub_id"/>
        </createIndex>

        <createIndex tableName="webhook_deliveries" indexName="idx_webhook_deliveries_event_type">
            <column name="event_type"/>
        </createIndex>

        <createIndex tableName="webhook_deliveries" indexName="idx_webhook_deliveries_triggered_at">
            <column name="triggered_at" descending="true"/>
        </createIndex>

        <createIndex tableName="webhook_deliveries" indexName="idx_webhook_deliveries_user_event_time">
            <column name="user_pub_id"/>
            <column name="event_type"/>
            <column name="triggered_at" descending="true"/>
        </createIndex>

        <rollback>
            <dropTable tableName="webhook_deliveries"/>
        </rollback>
    </changeSet>

</databaseChangeLog>
