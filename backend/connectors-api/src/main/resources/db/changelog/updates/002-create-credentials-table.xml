<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="002-create-credentials-table" author="agimate">
        <createTable tableName="credentials">
            <column name="id" type="BIGSERIAL">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="pub_id" type="UUID">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="connector_id" type="BIGINT">
                <constraints nullable="false" foreignKeyName="fk_credentials_connector"
                             references="connectors(id)"/>
            </column>
            <column name="name" type="TEXT">
                <constraints nullable="false"/>
            </column>
            <column name="description" type="TEXT"/>
            <column name="encrypted_data" type="TEXT">
                <constraints nullable="false"/>
            </column>
            <column name="encryption_iv" type="TEXT">
                <constraints nullable="false"/>
            </column>
            <column name="enabled" type="BOOLEAN" defaultValueBoolean="true">
                <constraints nullable="false"/>
            </column>
            <column name="last_used_at" type="TIMESTAMP"/>
            <column name="deleted_at" type="TIMESTAMP"/>
            <column name="created_at" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="TIMESTAMP"/>
        </createTable>

        <createIndex tableName="credentials" indexName="idx_credentials_connector_id">
            <column name="connector_id"/>
        </createIndex>

        <createIndex tableName="credentials" indexName="idx_credentials_enabled_deleted">
            <column name="enabled"/>
            <column name="deleted_at"/>
        </createIndex>
    </changeSet>

</databaseChangeLog>
