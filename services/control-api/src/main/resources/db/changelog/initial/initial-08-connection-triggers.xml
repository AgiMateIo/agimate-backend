<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
         http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.29.xsd">

    <!-- Triggers of a dynamic connector instance (connected apps); informational, params_schema is
         raw JSON text. -->
    <changeSet id="create-connection-triggers" author="agimate">
        <createTable tableName="connection_triggers">
            <column name="id" type="UUID" defaultValueComputed="uuidv7()">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="connection_id" type="UUID">
                <constraints nullable="false"
                             foreignKeyName="fk_connection_triggers_connection"
                             references="connections(id)"
                             deleteCascade="true"/>
            </column>
            <column name="name" type="TEXT">
                <constraints nullable="false"/>
            </column>
            <column name="title" type="TEXT"/>
            <column name="description" type="TEXT"/>
            <column name="params_schema" type="TEXT"/>
            <column name="deleted_at" type="TIMESTAMP"/>
            <column name="created_at" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <!-- One trigger per name per instance among active rows; a re-discovered trigger reuses the
             row rather than colliding with its soft-deleted predecessor. -->
        <sql>
            CREATE UNIQUE INDEX uq_connection_triggers_connection_id_name_active
                ON connection_triggers (connection_id, name)
                WHERE deleted_at IS NULL;
        </sql>
    </changeSet>

</databaseChangeLog>
