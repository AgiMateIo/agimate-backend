<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
         http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.29.xsd">

    <!--
        Фоновые задачи коннекторов, разбираемые ConnectorJobScheduler (FOR UPDATE SKIP LOCKED).
        kind — дискриминатор: SYSTEM (декларативная, управляется reconcile-синком из getJobs(),
        уникальна по бизнес-ключу), AGENT (запланирована агентом), USER (зарезервировано под manage-API).
        paused_at — пользовательская пауза: scheduler не подхватывает строку, пока поле не NULL.
        user_id — владелец (всегда задан); agent_id — инициатор (NULL у декларативных задач).
    -->
    <changeSet id="create-connector-jobs-table" author="agimate">
        <createTable tableName="connector_jobs">
            <column name="id" type="UUID" defaultValueComputed="uuidv7()">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="connector_code" type="TEXT">
                <constraints nullable="false"/>
            </column>
            <column name="identity" type="TEXT"/>
            <column name="user_id" type="UUID">
                <constraints nullable="false"/>
            </column>
            <column name="agent_id" type="UUID"/>
            <column name="kind" type="TEXT">
                <constraints nullable="false"/>
            </column>
            <column name="name" type="TEXT">
                <constraints nullable="false"/>
            </column>
            <column name="type" type="TEXT">
                <constraints nullable="false"/>
            </column>
            <column name="config" type="JSONB" defaultValueComputed="'{}'::jsonb">
                <constraints nullable="false"/>
            </column>
            <column name="args" type="JSONB" defaultValueComputed="'{}'::jsonb">
                <constraints nullable="false"/>
            </column>
            <column name="status" type="TEXT" defaultValue="PENDING">
                <constraints nullable="false"/>
            </column>
            <column name="next_run_at" type="TIMESTAMP"/>
            <column name="timeout_seconds" type="INTEGER" defaultValueNumeric="300">
                <constraints nullable="false"/>
            </column>
            <column name="lease_until" type="TIMESTAMP"/>
            <column name="last_started_at" type="TIMESTAMP"/>
            <column name="last_error" type="TEXT"/>
            <column name="paused_at" type="TIMESTAMP"/>
            <column name="created_at" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <!--
            Бизнес-ключ (connector_code, identity, name) — инвариант только декларативных
            (SYSTEM) тасок. AGENT-задачи (time.schedule) делят общий name (time.fire) и не
            должны конфликтовать, поэтому уникальность ограничена kind = 'SYSTEM'.
        -->
        <sql>
            CREATE UNIQUE INDEX uq_connector_jobs_identity
                ON connector_jobs (connector_code, identity, name)
                WHERE kind = 'SYSTEM';
        </sql>

        <!--
            Pickup-запрос фильтрует по (status, next_run_at, lease_until) и сортирует по next_run_at.
            COMPLETED-строки (выполненные ONETIME) и приостановленные (paused_at) в pickup не участвуют.
        -->
        <sql>
            CREATE INDEX idx_connector_jobs_ready
                ON connector_jobs (next_run_at NULLS FIRST, lease_until)
                WHERE status &lt;&gt; 'COMPLETED' AND paused_at IS NULL;
        </sql>

        <!-- Под list/cancel задач конкретного агента. -->
        <createIndex tableName="connector_jobs" indexName="idx_connector_jobs_agent">
            <column name="agent_id"/>
        </createIndex>
    </changeSet>

</databaseChangeLog>
