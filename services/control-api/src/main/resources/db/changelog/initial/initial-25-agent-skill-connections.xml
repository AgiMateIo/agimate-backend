<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
         http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.29.xsd">

    <!-- Which instance exactly the skill means. The reference lives on the agent↔skill binding, not
         on the skill: the same skill on two agents is two different telegrams. A row here does NOT
         grant access — access is still agent_connections; this is «the skill works with that one». -->
    <changeSet id="create-agent-skill-connections-table" author="agimate">
        <createTable tableName="agent_skill_connections">
            <column name="id" type="UUID" defaultValueComputed="uuidv7()">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="agent_skill_id" type="UUID">
                <constraints nullable="false"
                             foreignKeyName="fk_agent_skill_connections_agent_skill"
                             references="agent_skills(id)" deleteCascade="true"/>
            </column>
            <column name="connector_code" type="TEXT">
                <constraints nullable="false"/>
            </column>
            <column name="connection_id" type="UUID">
                <constraints nullable="false"
                             foreignKeyName="fk_agent_skill_connections_connection"
                             references="connections(id)"/>
            </column>
            <column name="created_at" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <!-- One instance per declared code within one skill binding: «this skill on this agent works
             with this telegram», there can be no second answer. -->
        <addUniqueConstraint tableName="agent_skill_connections"
                             columnNames="agent_skill_id, connector_code"
                             constraintName="uq_agent_skill_connections_agent_skill_id_connector_code"/>

        <!-- The reverse question — how many of the agent's skills point at this connection — is a
             counter in the connection listing. -->
        <createIndex tableName="agent_skill_connections" indexName="idx_agent_skill_connections_connection_id">
            <column name="connection_id"/>
        </createIndex>
    </changeSet>

</databaseChangeLog>
