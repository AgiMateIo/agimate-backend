<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
         http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.29.xsd">

    <changeSet id="create-agent-tool-policies-table" author="agimate">
        <createTable tableName="agent_tool_policies">
            <column name="id" type="UUID" defaultValueComputed="uuidv7()">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="agent_id" type="UUID">
                <constraints nullable="false"/>
            </column>
            <column name="user_id" type="UUID">
                <constraints nullable="false"/>
            </column>
            <column name="connector_code" type="TEXT"/>
            <column name="connector_identity" type="TEXT"/>
            <column name="tool_name" type="TEXT"/>
            <column name="effect" type="TEXT">
                <constraints nullable="false"/>
            </column>
            <column name="priority" type="INTEGER"/>
            <column name="description" type="TEXT"/>
            <column name="source" type="TEXT"/>
            <column name="channel_id" type="UUID"/>
            <column name="created_at" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <sql>
            ALTER TABLE agent_tool_policies
                ADD CONSTRAINT chk_agent_tool_policies_effect CHECK (effect IN ('ALLOW', 'DENY'));
            ALTER TABLE agent_tool_policies
                ADD CONSTRAINT chk_agent_tool_policies_identity_requires_connector CHECK (connector_identity IS NULL OR connector_code IS NOT NULL);
            ALTER TABLE agent_tool_policies
                ADD CONSTRAINT chk_agent_tool_policies_tool_requires_connector CHECK (tool_name IS NULL OR connector_code IS NOT NULL);
        </sql>

        <sql>
            CREATE UNIQUE INDEX uq_agent_tool_policies_composite
                ON agent_tool_policies (agent_id, connector_code, connector_identity, tool_name, effect)
                NULLS NOT DISTINCT;
        </sql>

        <addForeignKeyConstraint baseTableName="agent_tool_policies"
                                 baseColumnNames="channel_id"
                                 constraintName="fk_agent_tool_policies_channel"
                                 referencedTableName="channels"
                                 referencedColumnNames="id"
                                 onDelete="CASCADE"/>

        <createIndex tableName="agent_tool_policies" indexName="idx_agent_tool_policies_user_id">
            <column name="user_id"/>
        </createIndex>
        <createIndex tableName="agent_tool_policies" indexName="idx_agent_tool_policies_channel_id">
            <column name="channel_id"/>
        </createIndex>
    </changeSet>

</databaseChangeLog>
