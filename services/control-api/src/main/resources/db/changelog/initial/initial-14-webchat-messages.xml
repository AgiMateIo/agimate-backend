<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
         http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.29.xsd">

    <!-- Webchat UI log: what was actually rendered to the user, not LLM turns. -->
    <changeSet id="create-webchat-messages-table" author="agimate">
        <createTable tableName="webchat_messages">
            <column name="id" type="UUID" defaultValueComputed="uuidv7()">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="created_at" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="user_id" type="UUID">
                <constraints nullable="false"/>
            </column>
            <column name="agent_id" type="UUID">
                <constraints nullable="false"/>
            </column>
            <column name="channel_id" type="UUID">
                <constraints nullable="false"/>
            </column>
            <column name="session_id" type="UUID">
                <constraints nullable="false"/>
            </column>
            <column name="direction" type="TEXT">
                <constraints nullable="false"/>
            </column>
            <column name="stream" type="TEXT"/>
            <column name="message_id" type="TEXT">
                <constraints nullable="false"/>
            </column>
            <column name="text" type="TEXT"/>
            <column name="parts" type="JSONB"/>
        </createTable>

        <sql>
            ALTER TABLE webchat_messages
                ADD CONSTRAINT chk_webchat_messages_direction CHECK (direction IN ('USER', 'AGENT'));
        </sql>

        <!-- Delivery idempotency: message_id is deterministic, so a DBOS replay does not duplicate rows. -->
        <addUniqueConstraint tableName="webchat_messages"
                             columnNames="session_id, message_id"
                             constraintName="uq_webchat_messages_session_id_message_id"/>

        <addForeignKeyConstraint baseTableName="webchat_messages"
                                 baseColumnNames="session_id"
                                 constraintName="fk_webchat_messages_session"
                                 referencedTableName="agent_sessions"
                                 referencedColumnNames="id"
                                 onDelete="CASCADE"/>
        <addForeignKeyConstraint baseTableName="webchat_messages"
                                 baseColumnNames="channel_id"
                                 constraintName="fk_webchat_messages_channel"
                                 referencedTableName="channels"
                                 referencedColumnNames="id"
                                 onDelete="CASCADE"/>

        <!-- Time-ordered history paging; the (session_id, message_id) unique does not cover it. -->
        <createIndex tableName="webchat_messages" indexName="idx_webchat_messages_session_id_created_at">
            <column name="session_id"/>
            <column name="created_at"/>
        </createIndex>
    </changeSet>

</databaseChangeLog>
