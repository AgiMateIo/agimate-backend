<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
         http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.29.xsd">

    <changeSet id="create-trigger-logs-table" author="agimate">
        <createTable tableName="trigger_logs">
            <column name="id" type="UUID" defaultValueComputed="uuidv7()">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="created_at" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="user_id" type="UUID">
                <constraints nullable="false"/>
            </column>
            <column name="occurred_at" type="TIMESTAMP"/>
            <column name="connector_code" type="TEXT">
                <constraints nullable="false"/>
            </column>
            <!-- connections.id as text: the log outlives the instance, hence no FK. -->
            <column name="connection_id" type="TEXT">
                <constraints nullable="false"/>
            </column>
            <column name="external_id" type="TEXT">
                <constraints nullable="false"/>
            </column>
            <column name="name" type="TEXT">
                <constraints nullable="false"/>
            </column>
            <column name="input" type="JSONB">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <!-- user_id leads this key, so its index also serves the per-user listing. -->
        <addUniqueConstraint tableName="trigger_logs"
                             columnNames="user_id, connector_code, connection_id, name, external_id"
                             constraintName="uq_trigger_logs_user_connector_code_connection_name_external"/>

        <createIndex tableName="trigger_logs" indexName="idx_trigger_logs_created_at">
            <column name="created_at" descending="true"/>
        </createIndex>
    </changeSet>

</databaseChangeLog>
