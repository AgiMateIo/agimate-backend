<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
         http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.29.xsd">

    <!-- Connector instance registry; id = connection_id everywhere downstream. For internal
         connectors a connection is a mode row, one per user — the data owner is resolved by
         connector code from ConnectorEnv, so no scope is stored here. -->
    <changeSet id="create-connections-table" author="agimate">
        <createTable tableName="connections">
            <column name="id" type="UUID" defaultValueComputed="uuidv7()">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="connector_code" type="TEXT">
                <constraints nullable="false"
                             foreignKeyName="fk_connections_connectors"
                             references="connectors(code)"/>
            </column>
            <!-- Instance discriminator: mcp — from URL; telegram — username; app — from apps. -->
            <column name="sub_code" type="TEXT"/>
            <!-- Client-facing handle (mcp_context7); tool namespace prefix. -->
            <column name="full_code" type="TEXT">
                <constraints nullable="false"/>
            </column>
            <column name="user_id" type="UUID">
                <constraints nullable="false"/>
            </column>
            <column name="name" type="TEXT"/>
            <!-- Outbound credentials (telegram/mcp); null for internal/app. -->
            <column name="secret_id" type="UUID">
                <constraints foreignKeyName="fk_connections_secret" references="secrets(id)"/>
            </column>
            <!-- APP instances: app auth and device linking live in apps, not duplicated here. -->
            <column name="app_id" type="UUID">
                <constraints foreignKeyName="fk_connections_app" references="apps(id)"/>
            </column>
            <column name="webhook_secret_id" type="UUID">
                <constraints foreignKeyName="fk_connections_webhook_secret" references="secrets(id)"/>
            </column>
            <column name="enabled" type="BOOLEAN" defaultValueBoolean="true">
                <constraints nullable="false"/>
            </column>
            <column name="last_used_at" type="TIMESTAMP"/>
            <column name="deleted_at" type="TIMESTAMP"/>
            <column name="created_at" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <!-- Instance uniqueness among active rows. -->
        <sql>
            CREATE UNIQUE INDEX uq_connections_connector_user_subcode
                ON connections (connector_code, user_id, sub_code)
                WHERE deleted_at IS NULL;
        </sql>
        <!-- Handle uniqueness among the user's active rows. -->
        <sql>
            CREATE UNIQUE INDEX uq_connections_full_code_user
                ON connections (full_code, user_id)
                WHERE deleted_at IS NULL;
        </sql>

        <createIndex tableName="connections" indexName="idx_connections_connector_code">
            <column name="connector_code"/>
        </createIndex>
        <createIndex tableName="connections" indexName="idx_connections_user_id">
            <column name="user_id"/>
        </createIndex>
        <createIndex tableName="connections" indexName="idx_connections_app_id">
            <column name="app_id"/>
        </createIndex>
    </changeSet>

</databaseChangeLog>
