<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
         http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.29.xsd">

    <!-- Connector instance registry; id = connection_id everywhere downstream. For internal
         connectors a connection is a mode row, one per user — the data owner is resolved by
         connector code from ConnectorEnv, so no scope is stored here. -->
    <changeSet id="create-connections-table" author="agimate">
        <createTable tableName="connections">
            <column name="id" type="UUID" defaultValueComputed="uuidv7()">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="created_at" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="user_id" type="UUID">
                <constraints nullable="false"/>
            </column>
            <!-- Outbound credentials (telegram/mcp); null for internal/app. -->
            <column name="secret_id" type="UUID">
                <constraints foreignKeyName="fk_connections_secret" references="secrets(id)"/>
            </column>
            <!-- APP instances: app auth and device linking live in apps, not duplicated here. -->
            <column name="app_id" type="UUID">
                <constraints foreignKeyName="fk_connections_app" references="apps(id)"/>
            </column>
            <column name="webhook_secret_id" type="UUID">
                <constraints foreignKeyName="fk_connections_webhook_secret" references="secrets(id)"/>
            </column>
            <!-- The two dated halves of the OAuth state below: how long the authorisation attempt is
                 valid, and when the token dies. oauth_expires_at is a column and not part of the secret
                 even though it travels with the token — inside the blob «who needs refreshing» could be
                 answered neither by a query nor by the UI. NULL there means «unknown» (the AS sent no
                 expires_in), never «expired». -->
            <column name="oauth_state_expires_at" type="TIMESTAMP"/>
            <column name="oauth_expires_at" type="TIMESTAMP"/>
            <column name="last_used_at" type="TIMESTAMP"/>
            <column name="deleted_at" type="TIMESTAMP"/>
            <column name="enabled" type="BOOLEAN" defaultValueBoolean="true">
                <constraints nullable="false"/>
            </column>
            <column name="connector_code" type="TEXT">
                <constraints nullable="false"
                             foreignKeyName="fk_connections_connector_code"
                             references="connectors(code)"/>
            </column>
            <!-- Instance discriminator: mcp — from URL; telegram — username; app — from apps. -->
            <column name="sub_code" type="TEXT"/>
            <!-- Repeats sub_code where a second instance of the same account is harmful and stays
                 NULL where several accounts are legitimate (NULLs never collide on a unique index),
                 so «may this connector have two instances» becomes data instead of code. Filled by
                 ConnectionService.create from IntegrationConnectorHandler.allowsMultipleInstances(). -->
            <column name="exclusive_sub_code" type="TEXT"/>
            <!-- Client-facing handle (mcp_context7); tool namespace prefix. -->
            <column name="full_code" type="TEXT">
                <constraints nullable="false"/>
            </column>
            <column name="name" type="TEXT"/>
            <!-- OAuth for connector instances (docs/decisions/mcp-oauth.md). Only what has to be
                 searched or shown without decrypting the secret becomes a column: the tokens, the
                 issuer, the AS endpoints and the granted scope stay inside the connection's secret.
                 The dated half of this state sits with the other timestamps above. -->
            <column name="auth_status" type="TEXT" defaultValue="AUTHORIZED">
                <constraints nullable="false"/>
            </column>
            <column name="oauth_state" type="TEXT"/>
        </createTable>

        <!-- Instance uniqueness among active rows, but only where a second instance would do harm
             (for telegram it silently steals webhook delivery from the first). The alternative —
             «connector_code <> 'mcp'» inside the index — rots on the second multi-instance
             connector; a check in application code loses the race between two parallel creates. -->
        <sql>
            CREATE UNIQUE INDEX uq_connections_connector_code_user_id_exclusive_sub_code_active
                ON connections (connector_code, user_id, exclusive_sub_code)
                WHERE deleted_at IS NULL;
        </sql>
        <!-- Handle uniqueness among the user's active rows. -->
        <sql>
            CREATE UNIQUE INDEX uq_connections_full_code_user_id_active
                ON connections (full_code, user_id)
                WHERE deleted_at IS NULL;
        </sql>
        <!-- Lookup key of the OAuth callback: the state travels in the URL and is resolved back to
             the row. -->
        <sql>
            CREATE UNIQUE INDEX uq_connections_oauth_state
                ON connections (oauth_state)
                WHERE oauth_state IS NOT NULL;
        </sql>

        <createIndex tableName="connections" indexName="idx_connections_connector_code">
            <column name="connector_code"/>
        </createIndex>
        <createIndex tableName="connections" indexName="idx_connections_user_id">
            <column name="user_id"/>
        </createIndex>
        <createIndex tableName="connections" indexName="idx_connections_app_id">
            <column name="app_id"/>
        </createIndex>
    </changeSet>

</databaseChangeLog>
