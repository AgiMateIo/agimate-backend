<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
         http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.29.xsd">

    <!-- Agent role presets for the creation wizard. Declarative content: instructions are copied
         into the agent, skills are referenced by name. Seeded from classpath (PRESET.md),
         idempotent by name. -->
    <changeSet id="create-agent-presets-table" author="agimate">
        <createTable tableName="agent_presets">
            <column name="id" type="UUID" defaultValueComputed="uuidv7()">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <!-- Stable slug ('personal-assistant') — the idempotent seeding key. -->
            <column name="name" type="TEXT">
                <constraints nullable="false"/>
            </column>
            <column name="title" type="TEXT">
                <constraints nullable="false"/>
            </column>
            <column name="description" type="TEXT"/>
            <!-- Copied into agents.instructions on creation. -->
            <column name="instructions" type="TEXT">
                <constraints nullable="false"/>
            </column>
            <!-- System skill names, resolved by (SYSTEM_USER_ID, name) on listing. -->
            <column name="skill_names" type="text[]" defaultValueComputed="'{}'::text[]">
                <constraints nullable="false"/>
            </column>
            <!-- The preset can say what kind of agent it creates: the external-agent wizard (no model
                 and no prompt, but a delivery choice) is a different set of steps, and the preset
                 should decide that, not a list of codes hardcoded in the frontend. NULL = the type is
                 asked in the wizard. No check of the allowed values — the type is validated when the
                 agent is created, not here. -->
            <column name="agent_type" type="TEXT"/>
            <column name="sort_order" type="INTEGER" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
            <column name="enabled" type="BOOLEAN" defaultValueBoolean="true">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <addUniqueConstraint tableName="agent_presets"
                             columnNames="name"
                             constraintName="uq_agent_presets_name"/>
    </changeSet>

</databaseChangeLog>
