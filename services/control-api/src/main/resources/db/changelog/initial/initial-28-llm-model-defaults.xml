<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
         http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.29.xsd">

    <!-- Curated capability fallback for providers whose /models returns bare ids without metadata.
         Applied per field on refresh, discovered values win; a missing row means unknown. -->
    <changeSet id="create-llm-model-defaults-table" author="agimate">
        <createTable tableName="llm_model_defaults">
            <column name="id" type="UUID" defaultValueComputed="uuidv7()">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="model" type="TEXT">
                <constraints nullable="false" unique="true" uniqueConstraintName="uq_llm_model_defaults_model"/>
            </column>
            <column name="display_name" type="TEXT"/>
            <column name="context_window" type="INTEGER"/>
            <column name="max_output_tokens" type="INTEGER"/>
            <column name="input_modalities" type="JSONB"/>
            <column name="output_modalities" type="JSONB"/>
            <column name="supported_parameters" type="JSONB"/>
            <column name="created_at" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>

</databaseChangeLog>
