<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
         http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.29.xsd">

    <!-- Curated capability fallback for providers whose /models returns bare ids without metadata.
         Applied per field on refresh, discovered values win; a missing row means unknown.

         The table is created empty. The rows used to be an INSERT block here (ON CONFLICT DO
         NOTHING), which froze the snapshot at whatever an installation was first seeded with; they
         now come from resources/seed/llm-models.yaml, upserted on every start by
         LlmModelDefaultsBootstrap, so refreshing the snapshot is a deploy. The old changeset stays
         recorded in DATABASECHANGELOG on databases that ran it — its rows are simply overwritten by
         the first start on the new build. -->
    <changeSet id="create-llm-model-defaults-table" author="agimate">
        <createTable tableName="llm_model_defaults">
            <column name="id" type="UUID" defaultValueComputed="uuidv7()">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="model" type="TEXT">
                <constraints nullable="false" unique="true" uniqueConstraintName="uq_llm_model_defaults_model"/>
            </column>
            <column name="display_name" type="TEXT"/>
            <column name="context_window" type="INTEGER"/>
            <column name="max_output_tokens" type="INTEGER"/>
            <column name="input_modalities" type="JSONB"/>
            <column name="output_modalities" type="JSONB"/>
            <column name="supported_parameters" type="JSONB"/>
            <column name="created_at" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>

</databaseChangeLog>
