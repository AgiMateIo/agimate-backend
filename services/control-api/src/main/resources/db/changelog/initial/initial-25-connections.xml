<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
         http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.29.xsd">

    <!--
        Единый реестр экземпляров коннекторов. id = identity во всём downstream (channels, policies,
        trigger_logs, tool_call_logs, connector_jobs). Outbound-секрет (telegram/mcp) — в secrets
        (secret_id); APP-экземпляр ссылается на устройство через app_id (apps).
    -->
    <changeSet id="create-connections-table" author="agimate">
        <createTable tableName="connections">
            <column name="id" type="UUID" defaultValueComputed="uuidv7()">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="connector_code" type="TEXT">
                <constraints nullable="false"
                             foreignKeyName="fk_connections_connectors"
                             references="connectors(code)"/>
            </column>
            <!-- Дискриминатор инстанса: mcp — из URL; telegram — username; app — из apps. -->
            <column name="sub_code" type="TEXT"/>
            <!-- Стабильный клиентский handle: connector_code + '_' + sub_code (mcp_context7);
                 для статических singleton = connector_code. Префикс неймспейса тулов. -->
            <column name="full_code" type="TEXT">
                <constraints nullable="false"/>
            </column>
            <column name="user_id" type="UUID">
                <constraints nullable="false"/>
            </column>
            <column name="name" type="TEXT"/>
            <!-- Outbound-credentials (telegram/mcp): ссылка на secrets. null для internal/app. -->
            <column name="secret_id" type="UUID">
                <constraints foreignKeyName="fk_connections_secret" references="secrets(id)"/>
            </column>
            <!-- APP-тип: ссылка на apps (device-auth/linking не дублируем). -->
            <column name="app_id" type="UUID">
                <constraints foreignKeyName="fk_connections_app" references="apps(id)"/>
            </column>
            <column name="webhook_secret" type="TEXT"/>
            <column name="enabled" type="BOOLEAN" defaultValueBoolean="true">
                <constraints nullable="false"/>
            </column>
            <column name="last_used_at" type="TIMESTAMP"/>
            <column name="deleted_at" type="TIMESTAMP"/>
            <column name="created_at" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <!-- Уникальность инстанса среди активных строк. -->
        <sql>
            CREATE UNIQUE INDEX uq_connections_connector_user_subcode
                ON connections (connector_code, user_id, sub_code)
                WHERE deleted_at IS NULL;
        </sql>
        <!-- Уникальность клиентского handle среди активных строк пользователя. -->
        <sql>
            CREATE UNIQUE INDEX uq_connections_full_code_user
                ON connections (full_code, user_id)
                WHERE deleted_at IS NULL;
        </sql>

        <createIndex tableName="connections" indexName="idx_connections_connector_code">
            <column name="connector_code"/>
        </createIndex>
        <createIndex tableName="connections" indexName="idx_connections_user_id">
            <column name="user_id"/>
        </createIndex>
        <createIndex tableName="connections" indexName="idx_connections_app_id">
            <column name="app_id"/>
        </createIndex>
    </changeSet>

</databaseChangeLog>
