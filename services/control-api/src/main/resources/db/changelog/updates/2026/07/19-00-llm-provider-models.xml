<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <!-- Реестр моделей провайдера: заменяет JSONB-кэш llm_providers.available_models.
         Строка = (provider, model): discovery-метаданные (context_window, модальности),
         lifecycle (status, first/last_seen_at — модель может пропасть из листинга провайдера,
         биндинги агентов должны это видеть) и конфиг-оверрайд extra_body (доп. параметры тела
         chat/completions для конкретной модели, поверх провайдер-уровня llm_providers.extra_body).
         Строки при пропаже из листинга НЕ удаляются (на них конфиг и биндинги) — только
         status=UNAVAILABLE. -->
    <changeSet id="2026-07-19-00-llm-provider-models" author="agimate">
        <createTable tableName="llm_provider_models">
            <column name="id" type="UUID" defaultValueComputed="uuidv7()">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="provider_id" type="UUID">
                <constraints nullable="false"/>
            </column>
            <column name="model" type="TEXT">
                <constraints nullable="false"/>
            </column>
            <column name="display_name" type="TEXT"/>
            <column name="context_window" type="INTEGER"/>
            <column name="input_modalities" type="JSONB"/>
            <column name="supported_parameters" type="JSONB"/>
            <column name="extra_body" type="JSONB"/>
            <column name="status" type="TEXT" defaultValue="AVAILABLE">
                <constraints nullable="false"/>
            </column>
            <!-- null = модель ни разу не встречалась в листинге провайдера (конфиг заведён руками) -->
            <column name="first_seen_at" type="TIMESTAMP"/>
            <column name="last_seen_at" type="TIMESTAMP"/>
            <column name="created_at" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <addUniqueConstraint tableName="llm_provider_models"
                             columnNames="provider_id, model"
                             constraintName="uq_llm_provider_models_provider_model"/>

        <addForeignKeyConstraint baseTableName="llm_provider_models"
                                 baseColumnNames="provider_id"
                                 constraintName="fk_llm_provider_models_provider"
                                 referencedTableName="llm_providers"
                                 referencedColumnNames="id"
                                 onDelete="CASCADE"/>
    </changeSet>

    <!-- Провайдер-уровневые доп. параметры тела chat/completions (например
         provider-роутинг OpenRouter, transforms). Мёржатся с пер-модельным extra_body
         (модель побеждает) в getLlmCredentials. НЕ секрет: уходит воркеру открытым полем. -->
    <changeSet id="2026-07-19-00-llm-providers-extra-body" author="agimate">
        <addColumn tableName="llm_providers">
            <column name="extra_body" type="JSONB"/>
        </addColumn>
    </changeSet>

    <!-- Перенос кэша available_models в реестр: обе даты = models_refreshed_at (момент,
         когда модель реально видели в листинге). -->
    <changeSet id="2026-07-19-00-migrate-available-models" author="agimate">
        <sql>
            INSERT INTO llm_provider_models (provider_id, model, display_name, status, first_seen_at, last_seen_at)
            SELECT p.id,
                   m->>'id',
                   m->>'displayName',
                   'AVAILABLE',
                   COALESCE(p.models_refreshed_at, CURRENT_TIMESTAMP),
                   COALESCE(p.models_refreshed_at, CURRENT_TIMESTAMP)
            FROM llm_providers p
            CROSS JOIN LATERAL jsonb_array_elements(p.available_models) m
            WHERE p.available_models IS NOT NULL
              AND jsonb_typeof(p.available_models) = 'array'
              AND m->>'id' IS NOT NULL
            ON CONFLICT (provider_id, model) DO NOTHING;
        </sql>
        <dropColumn tableName="llm_providers" columnName="available_models"/>
    </changeSet>

</databaseChangeLog>
