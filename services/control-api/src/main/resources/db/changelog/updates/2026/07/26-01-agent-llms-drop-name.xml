<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
         http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.29.xsd">

    <!-- Идентичность биндинга — (agent_id, purpose): label никогда не участвовал в выборе модели
         (chat брал «первый по имени», медиа — строго по purpose), так что метка была рудиментом. -->
    <changeSet id="agent-llms-drop-name" author="agimate">
        <dropUniqueConstraint tableName="agent_llms" constraintName="uq_agent_llms_agent_name"/>
        <dropColumn tableName="agent_llms" columnName="name"/>
        <addUniqueConstraint tableName="agent_llms"
                             columnNames="agent_id, purpose"
                             constraintName="uq_agent_llms_agent_purpose"/>
    </changeSet>

</databaseChangeLog>
