<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <!-- Протокол v2, этап 3 (SaveMessage): история = «диалог как видел пользователь».
         kind расширяется (INBOUND/PROGRESS/ANSWER/ERROR, старые REQUEST/RESPONSE остаются читаемыми),
         message_json больше не пишется (nullable), порядок даёт uuidv7-PK (turn_idx дропается),
         идемпотентность — (run_id, seq), completed=true ставится всем сообщениям рана при финальном
         ANSWER (незавершённые раны выпадают из истории следующих ранов). -->
    <changeSet id="2026-07-10-01-message-log-v2" author="agimate">
        <dropNotNullConstraint tableName="channel_session_messages" columnName="message_json"/>

        <dropUniqueConstraint tableName="channel_session_messages"
                              constraintName="uq_channel_session_messages_session_turn"/>
        <dropColumn tableName="channel_session_messages" columnName="turn_idx"/>

        <addColumn tableName="channel_session_messages">
            <column name="seq" type="INTEGER"/>
            <column name="progress_type" type="TEXT"/>
            <column name="completed" type="BOOLEAN" defaultValueBoolean="false">
                <constraints nullable="false"/>
            </column>
        </addColumn>

        <!-- Дореформенные строки — завершённые диалоги: остаются видимыми в истории. -->
        <update tableName="channel_session_messages">
            <column name="completed" valueBoolean="true"/>
        </update>

        <addUniqueConstraint tableName="channel_session_messages"
                             columnNames="run_id, seq"
                             constraintName="uq_channel_session_messages_run_seq"/>
    </changeSet>

</databaseChangeLog>
