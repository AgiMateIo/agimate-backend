<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <!-- Реестр активных ранов (RegisterRun/ReleaseRun) выпилен: single-writer-per-session
         держит партиционированная очередь agent_exec (контрактное требование к транспорту),
         status — проекция потока SaveMessage (INBOUND→RUNNING, ANSWER→DONE, ERROR→FAILED),
         наблюдаемость. Lease (expires_at) заменяется меткой активности last_activity_at
         (продлевается RPC рана); залипшие RUNNING добирает фоновый сборщик. -->
    <changeSet id="2026-07-12-00-run-activity" author="agimate">
        <!-- Статус больше не лок: два RUNNING в сессии легальны (ран, умерший без ERROR,
             и его сосед по очереди) — уникальный индекс превратил бы наблюдаемость в сбой. -->
        <sql>
            DROP INDEX IF EXISTS uq_trigger_log_agents_active_session;
        </sql>

        <addColumn tableName="trigger_log_agents">
            <column name="last_activity_at" type="TIMESTAMP"/>
        </addColumn>

        <!-- Дореформенные RUNNING-строки: точка отсчёта для сборщика. -->
        <sql>
            UPDATE trigger_log_agents SET last_activity_at = updated_at WHERE status = 'RUNNING';
        </sql>

        <dropColumn tableName="trigger_log_agents" columnName="expires_at"/>
    </changeSet>

</databaseChangeLog>
