<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
         http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.29.xsd">

    <changeSet id="create-connector-tasks-table" author="agimate">
        <createTable tableName="connector_tasks">
            <column name="id" type="UUID" defaultValueComputed="uuidv7()">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="connector_code" type="TEXT">
                <constraints nullable="false"/>
            </column>
            <column name="identity" type="TEXT"/>
            <column name="task_name" type="TEXT">
                <constraints nullable="false"/>
            </column>
            <column name="task_type" type="TEXT">
                <constraints nullable="false"/>
            </column>
            <column name="task_config" type="JSONB" defaultValueComputed="'{}'::jsonb">
                <constraints nullable="false"/>
            </column>
            <column name="task_args" type="JSONB" defaultValueComputed="'{}'::jsonb">
                <constraints nullable="false"/>
            </column>
            <column name="status" type="TEXT" defaultValue="PENDING">
                <constraints nullable="false"/>
            </column>
            <column name="next_run_at" type="TIMESTAMP"/>
            <column name="timeout_seconds" type="INTEGER" defaultValueNumeric="300">
                <constraints nullable="false"/>
            </column>
            <column name="lease_until" type="TIMESTAMP"/>
            <column name="last_started_at" type="TIMESTAMP"/>
            <column name="last_error" type="TEXT"/>
            <column name="created_at" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <!--
            Уникальность бизнес‑ключа (connector_code, identity, task_name). PostgreSQL не считает
            NULL = NULL, поэтому обычный UNIQUE не поймает дубли среди глобальных строк
            (identity IS NULL). Используем два частичных индекса.
        -->
        <sql>
            CREATE UNIQUE INDEX uq_connector_tasks_global
                ON connector_tasks (connector_code, task_name)
                WHERE identity IS NULL;

            CREATE UNIQUE INDEX uq_connector_tasks_identity
                ON connector_tasks (connector_code, identity, task_name)
                WHERE identity IS NOT NULL;
        </sql>

        <!--
            Pickup‑запрос фильтрует по (status, next_run_at, lease_until) и сортирует по
            next_run_at. COMPLETED-строки (выполненные ONETIME) в pickup не участвуют —
            partial index держит размер маленьким.
        -->
        <sql>
            CREATE INDEX idx_connector_tasks_ready
                ON connector_tasks (next_run_at NULLS FIRST, lease_until)
                WHERE status &lt;&gt; 'COMPLETED';
        </sql>
    </changeSet>

</databaseChangeLog>
