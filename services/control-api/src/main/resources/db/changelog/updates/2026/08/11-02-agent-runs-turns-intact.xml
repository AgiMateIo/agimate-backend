<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
         http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.29.xsd">

    <!-- История следующего рана собирается из agent_run_turns, а SaveTurn — best-effort: потерянный
         ход оставляет tool_use без своего tool_result, и такой запрос провайдер отвергает целиком.
         Журнал проверяется один раз, в момент завершения рана (непрерывность turn_index и парность
         последнего хода), результат остаётся здесь. Значение по умолчанию TRUE относится к строкам,
         созданным до этой колонки: журнала у них нет вовсе, в историю они всё равно не попадут. -->
    <changeSet id="agent-runs-turns-intact" author="agimate">
        <addColumn tableName="agent_runs">
            <column name="turns_intact" type="BOOLEAN" defaultValueBoolean="true">
                <constraints nullable="false"/>
            </column>
        </addColumn>
    </changeSet>

    <!-- Окно истории — последние N ранов сессии. Ходы затем выбираются по run_id IN (...), что
         обслуживает уже существующий uq_agent_run_turns_run_turn, поэтому индекс нужен только здесь. -->
    <changeSet id="agent-runs-session-created-index" author="agimate">
        <createIndex tableName="agent_runs" indexName="idx_agent_runs_session_created">
            <column name="session_id"/>
            <column name="created_at"/>
        </createIndex>
    </changeSet>

</databaseChangeLog>
