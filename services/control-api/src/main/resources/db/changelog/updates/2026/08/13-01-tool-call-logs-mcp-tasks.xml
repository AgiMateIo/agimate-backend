<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
         http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.29.xsd">

    <!-- MCP-таски (расширение io.modelcontextprotocol/tasks): вызов, не уложившийся в grace,
         отдаётся клиенту таском (taskId = external_id; таск = строка с detached_at), результат
         клиент забирает поллингом tasks/get.

         cancel_requested_at — кооперативная отмена tasks/cancel. Ставится guarded-UPDATE'ом только
         пока вызов не завершён (finish_at IS NULL): штамп по построению означает «отменили во время
         работы», поэтому завершённая строка со штампом читается как cancelled (результат клиенту
         не отдаётся), а отмена уже завершённого таска — 0 строк, и таск остаётся completed.
         Само исполнение не прерывается: interrupt посреди чужого API оставил бы неизвестное
         состояние на той стороне. -->
    <changeSet id="tool-call-logs-mcp-tasks" author="agimate">
        <addColumn tableName="tool_call_logs">
            <column name="cancel_requested_at" type="TIMESTAMP">
                <constraints nullable="true"/>
            </column>
        </addColumn>
    </changeSet>

</databaseChangeLog>
