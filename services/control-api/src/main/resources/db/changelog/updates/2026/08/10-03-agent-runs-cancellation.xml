<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
         http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.29.xsd">

    <!-- Запрос отмены отделён от статуса: между нажатием и остановкой проходит текущий шаг, и всё это
         время ран ещё RUNNING. Иначе пришлось бы либо врать про мгновенность, либо заводить статус
         CANCELLING, ничего не значащий для очереди. Этим же полем разрешается гонка «отмена против
         финиша»: терминальный ANSWER с ним становится CANCELLED, без него — DONE. -->
    <changeSet id="agent-runs-cancellation" author="agimate">
        <addColumn tableName="agent_runs">
            <column name="cancel_requested_at" type="TIMESTAMP"/>
            <column name="cancelled_by" type="UUID"/>
        </addColumn>
    </changeSet>

</databaseChangeLog>
