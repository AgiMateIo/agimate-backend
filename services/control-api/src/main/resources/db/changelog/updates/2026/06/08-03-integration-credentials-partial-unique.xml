<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
         http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.29.xsd">

    <!--
        Original UNIQUE constraint (connector_code, user_id, platform_identifier) does not consider
        deleted_at, so a soft‑deleted row still blocks recreating the same integration. Replace it
        with a partial unique index that only covers active (deleted_at IS NULL) rows.
    -->
    <changeSet id="integration-credentials-partial-unique-active" author="agimate">
        <dropUniqueConstraint
                tableName="integration_credentials"
                constraintName="uq_integration_credentials_connector_user_identifier"/>

        <sql>
            CREATE UNIQUE INDEX uq_integration_credentials_connector_user_identifier
                ON integration_credentials (connector_code, user_id, platform_identifier)
                WHERE deleted_at IS NULL;
        </sql>
    </changeSet>

</databaseChangeLog>
