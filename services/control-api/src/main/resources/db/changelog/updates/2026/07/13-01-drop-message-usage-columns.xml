<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <!-- Наследие v1 (usage как атрибут LLM-хода-сообщения): v2 их не пишет и никто не читает.
         Учёт расхода живёт в llm_usage_log/llm_usage_counters (per-call, с llm_provider_id);
         стоимость рана в сессии — агрегация llm_usage_log по run_id. -->
    <changeSet id="2026-07-13-01-drop-message-usage-columns" author="agimate">
        <dropColumn tableName="channel_session_messages" columnName="input_tokens"/>
        <dropColumn tableName="channel_session_messages" columnName="output_tokens"/>
        <dropColumn tableName="channel_session_messages" columnName="cache_read_tokens"/>
        <dropColumn tableName="channel_session_messages" columnName="cache_write_tokens"/>
        <dropColumn tableName="channel_session_messages" columnName="model_name"/>
        <dropColumn tableName="channel_session_messages" columnName="provider_name"/>
    </changeSet>

</databaseChangeLog>
