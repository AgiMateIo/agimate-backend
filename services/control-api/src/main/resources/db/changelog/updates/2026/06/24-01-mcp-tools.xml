<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
         http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.29.xsd">

    <!--
        Кэш тулов MCP-коннектора. Тулы у MCP динамические и per-instance: каждый экземпляр
        (строка integration_credentials = URL сервера + auth) отдаёт свой набор через tools/list
        в рантайме. Кэшируем дискаверенные спеки здесь, чтобы воркер и UI политик видели список
        без обращения к удалённому серверу на горячем пути. Синк — на create/modify интеграции
        (McpToolDiscoveryListener, AFTER_COMMIT) + ручной refresh.

        Схемы (input_schema/output_schema) храним сырым JSON-текстом как пришли с сервера —
        гарантия фиделити произвольной JSON Schema (anyOf/$ref/format/...).
    -->
    <changeSet id="create-mcp-tool" author="agimate">
        <createTable tableName="mcp_tool">
            <column name="id" type="UUID" defaultValueComputed="uuidv7()">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="integration_credentials_id" type="UUID">
                <constraints nullable="false"
                             foreignKeyName="fk_mcp_tool_integration_credentials"
                             references="integration_credentials(id)"
                             deleteCascade="true"/>
            </column>
            <column name="name" type="TEXT">
                <constraints nullable="false"/>
            </column>
            <column name="title" type="TEXT"/>
            <column name="description" type="TEXT"/>
            <!-- Сырая JSON Schema как пришла с MCP-сервера (фиделити). -->
            <column name="input_schema" type="TEXT"/>
            <column name="output_schema" type="TEXT"/>
            <!-- JSON хинтов: {readOnlyHint,destructiveHint,idempotentHint,openWorldHint}. -->
            <column name="annotations" type="TEXT"/>
            <column name="created_at" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <!-- Бизнес-ключ: один тул с данным именем на сервер. PG создаст индекс под UNIQUE сам. -->
        <addUniqueConstraint tableName="mcp_tool"
                             columnNames="integration_credentials_id, name"
                             constraintName="uq_mcp_tool_identity_name"/>
    </changeSet>

</databaseChangeLog>
