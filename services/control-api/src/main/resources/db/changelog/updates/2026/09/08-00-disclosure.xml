<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
         http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.29.xsd">

    <!--
      Progressive disclosure (docs/decisions/progressive-disclosure.md): whether a connector's tool
      schemas and a skill's body go into a run up front (EAGER) or on demand (LAZY). Two columns,
      one per axis — the axes are independent and are switched on by two different connectors.
      The connector value is synced from the handler's traits by the bootstrap on every start, the
      skill value comes from SKILL.md on seeding only.
    -->
    <changeSet id="add-connectors-disclosure" author="agimate">
        <addColumn tableName="connectors">
            <column name="disclosure" type="TEXT" defaultValue="EAGER">
                <constraints nullable="false"/>
            </column>
        </addColumn>
        <sql>
            ALTER TABLE connectors
                ADD CONSTRAINT chk_connectors_disclosure CHECK (disclosure IN ('EAGER', 'LAZY'));
        </sql>
    </changeSet>

    <changeSet id="add-skills-disclosure" author="agimate">
        <addColumn tableName="skills">
            <column name="disclosure" type="TEXT" defaultValue="EAGER">
                <constraints nullable="false"/>
            </column>
        </addColumn>
        <sql>
            ALTER TABLE skills
                ADD CONSTRAINT chk_skills_disclosure CHECK (disclosure IN ('EAGER', 'LAZY'));
        </sql>
    </changeSet>

    <!--
      System skills are seed-only-if-missing, so the frontmatter value never reaches an environment
      seeded before the axis existed; the rows are set here instead. Every seeded skill is LAZY
      except the two behavioural ones — persist-memory (when to save a note) and media (how to
      iterate on pictures): the model never loads an instruction it does not know it needs.
      On a fresh environment the table is empty here and the frontmatter wins.
    -->
    <changeSet id="set-system-skills-disclosure" author="agimate">
        <sql>
            UPDATE skills
            SET disclosure = 'LAZY', updated_at = CURRENT_TIMESTAMP
            WHERE user_id = '00000000-0000-0000-0000-000000000000'
              AND deleted_at IS NULL
              AND name NOT IN ('persist-memory', 'media');
        </sql>
    </changeSet>

</databaseChangeLog>
