<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <!-- Модель по умолчанию: обязательна для платформенного провайдера (fallback-выдача
         агентам без agent_llms-привязки), для пользовательских провайдеров опциональна. -->
    <changeSet id="2026-07-12-01-llm-provider-default-model" author="agimate">
        <addColumn tableName="llm_providers">
            <column name="default_model" type="TEXT"/>
        </addColumn>
    </changeSet>

</databaseChangeLog>
