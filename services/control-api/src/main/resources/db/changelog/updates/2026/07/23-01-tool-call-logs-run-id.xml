<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
         http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.29.xsd">

    <!--
      Ран-инициатор тул-вызова: раньше run_id из ExecuteTool терялся на async-границе
      (@Async executeTool), поэтому media-usage писался в llm_usage_log с run_id = NULL.
      Колонка делает тул-вызовы run-attributable и питает ConnectorEnv.runId. Nullable —
      device/app-вызовы и лог без рана остаются валидными.
    -->
    <changeSet id="tool-call-logs-run-id" author="agimate">
        <addColumn tableName="tool_call_logs">
            <column name="run_id" type="UUID"/>
        </addColumn>
    </changeSet>

</databaseChangeLog>
