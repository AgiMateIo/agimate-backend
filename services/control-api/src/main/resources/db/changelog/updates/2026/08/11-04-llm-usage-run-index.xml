<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
         http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.29.xsd">

    <!-- «Run cost = aggregate of the log by run_id» записано ещё в initial-31, но индекса под этот
         агрегат не было: до сих пор по run_id никто не читал. Теперь читает вьюха ранов — расход
         собирается одним запросом на страницу списка. -->
    <changeSet id="llm-usage-log-run-index" author="agimate">
        <createIndex tableName="llm_usage_log" indexName="idx_llm_usage_log_run">
            <column name="run_id"/>
        </createIndex>
    </changeSet>

</databaseChangeLog>
