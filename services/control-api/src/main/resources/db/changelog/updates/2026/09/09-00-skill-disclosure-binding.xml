<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
         http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.29.xsd">

    <!--
      The skill's disclosure axis, overridden per binding: the same skill may sit in the prompt of
      one agent and be loaded on demand by another. NULL means «inherit the skill's own axis» — the
      binding stays a pointer, and a later change of the skill's default reaches it.
    -->
    <changeSet id="add-agent-skills-disclosure" author="agimate">
        <addColumn tableName="agent_skills">
            <column name="disclosure" type="TEXT">
                <constraints nullable="true"/>
            </column>
        </addColumn>
        <sql>
            ALTER TABLE agent_skills
                ADD CONSTRAINT chk_agent_skills_disclosure CHECK (disclosure IS NULL OR disclosure IN ('EAGER', 'LAZY'));
        </sql>
    </changeSet>

</databaseChangeLog>
