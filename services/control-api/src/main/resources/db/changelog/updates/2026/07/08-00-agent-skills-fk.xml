<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
         http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.29.xsd">

    <!-- FK для agent_skills. Позже переносится в initial-19 при пересборке initial-схемы. -->
    <changeSet id="add-agent-skills-fk" author="agimate">
        <!-- Осиротевшие привязки (агентов удаляли жёстко без каскада) — иначе FK не встанет. -->
        <sql>
            DELETE FROM agent_skills a WHERE NOT EXISTS (SELECT 1 FROM agents  x WHERE x.id = a.agent_id);
            DELETE FROM agent_skills a WHERE NOT EXISTS (SELECT 1 FROM skills  x WHERE x.id = a.skill_id);
        </sql>

        <addForeignKeyConstraint constraintName="fk_agent_skills_agent"
                                 baseTableName="agent_skills" baseColumnNames="agent_id"
                                 referencedTableName="agents" referencedColumnNames="id"
                                 onDelete="CASCADE"/>
        <addForeignKeyConstraint constraintName="fk_agent_skills_skill"
                                 baseTableName="agent_skills" baseColumnNames="skill_id"
                                 referencedTableName="skills" referencedColumnNames="id"/>

        <createIndex tableName="agent_skills" indexName="idx_agent_skills_skill_id">
            <column name="skill_id"/>
        </createIndex>
    </changeSet>

</databaseChangeLog>
