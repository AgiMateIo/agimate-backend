<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
         http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.29.xsd">

    <!-- Отложенные тулы: воркер ждёт результат не дольше grace-порога, дальше отцепляется (DetachTool),
         а результат по завершении уезжает агенту триггером tool_completed — новым раном той же сессии
         (бегущий main заберёт его стирингом).

         detached_at — смена владельца результата, видимая и необратимая: после неё GetToolResult
         навсегда отвечает DETACHED (даже завершившемуся вызову), реплей воркера пишет тот же interim,
         а бэкенд знает, что доставка за ним. Ставится guarded-UPDATE'ом с условием finish_at IS NULL —
         опоздавший detach получает готовый результат вместо штампа.

         delivered_at — «доставлено ровно один раз»: claim-first guarded-UPDATE перед созданием
         рана-доставщика. Без него повторный пост результата от app (recordOutputFromApp не защищён
         от дублей) породил бы второй ран и второй ответ пользователю. Ран доставки находится через
         trigger_logs.external_id = tool_call_logs.id. -->
    <changeSet id="tool-call-logs-detach" author="agimate">
        <addColumn tableName="tool_call_logs">
            <column name="detached_at" type="TIMESTAMP">
                <constraints nullable="true"/>
            </column>
            <column name="delivered_at" type="TIMESTAMP">
                <constraints nullable="true"/>
            </column>
        </addColumn>
    </changeSet>

</databaseChangeLog>
