<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
         http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.29.xsd">

    <!--
      Снимок prompt-сессии агента-инициатора на момент планирования динамической задачи
      (симметрично channel_id): при срабатывании ран напоминания получает историю и
      партицию исходного разговора, пока его сессия жива.
    -->
    <changeSet id="connector-jobs-session-id" author="agimate">
        <addColumn tableName="connector_jobs">
            <column name="session_id" type="UUID"/>
        </addColumn>
    </changeSet>

</databaseChangeLog>
