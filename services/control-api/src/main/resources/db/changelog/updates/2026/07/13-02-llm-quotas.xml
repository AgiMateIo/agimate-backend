<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <!-- Квоты расхода LLM-токенов (этап 3): объявляются на провайдере — платформенном
         (free-tier: subject_kind=USER, «каждому пользователю N») или BYOK (TOTAL — потолок
         кошелька, AGENT — лимит каждому агенту). Проверяются в GetLlmCredentials перед
         каждым LLM-вызовом против llm_usage_counters. -->
    <changeSet id="2026-07-13-02-llm-quotas" author="agimate">
        <createTable tableName="llm_quotas">
            <column name="id" type="UUID" defaultValueComputed="uuidv7()">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="llm_provider_id" type="UUID">
                <constraints nullable="false"/>
            </column>
            <column name="subject_kind" type="TEXT">
                <constraints nullable="false"/>
            </column>
            <column name="win" type="TEXT">
                <constraints nullable="false"/>
            </column>
            <column name="limit_tokens" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <addUniqueConstraint tableName="llm_quotas"
                             columnNames="llm_provider_id, subject_kind, win"
                             constraintName="uq_llm_quotas_key"/>

        <addForeignKeyConstraint baseTableName="llm_quotas"
                                 baseColumnNames="llm_provider_id"
                                 constraintName="fk_llm_quotas_provider"
                                 referencedTableName="llm_providers"
                                 referencedColumnNames="id"
                                 onDelete="CASCADE"/>
    </changeSet>

</databaseChangeLog>
