<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <!-- Пресеты ролей агента: заготовки для мастера создания (галерея ролей). Пресет —
         декларативный контент: instructions копируются в агента и дальше редактируются свободно,
         скилы привязываются по ссылке (skill_names — имена системных скилов, ключ
         (SYSTEM_USER_ID, name)). Сидится из classpath (PRESET.md), идемпотентно по code. -->
    <changeSet id="2026-07-13-03-agent-presets" author="agimate">
        <createTable tableName="agent_presets">
            <column name="id" type="UUID" defaultValueComputed="uuidv7()">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <!-- Стабильный слаг пресета ('personal-assistant') — ключ идемпотентного сидинга. -->
            <column name="code" type="TEXT">
                <constraints nullable="false"/>
            </column>
            <column name="name" type="TEXT">
                <constraints nullable="false"/>
            </column>
            <column name="description" type="TEXT"/>
            <!-- Заготовка системных инструкций агента; при создании копируется в agents.instructions. -->
            <column name="instructions" type="TEXT">
                <constraints nullable="false"/>
            </column>
            <!-- Имена системных скилов пресета; резолвятся по (SYSTEM_USER_ID, name) при листинге. -->
            <column name="skill_names" type="text[]" defaultValueComputed="'{}'::text[]">
                <constraints nullable="false"/>
            </column>
            <column name="sort_order" type="INTEGER" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
            <column name="enabled" type="BOOLEAN" defaultValueBoolean="true">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <addUniqueConstraint tableName="agent_presets"
                             columnNames="code"
                             constraintName="uq_agent_presets_code"/>

        <!-- Из какого пресета создан агент (аналитика воронки); свободная связь без FK —
             пресет может быть отключён/удалён, агент от этого не зависит. -->
        <addColumn tableName="agents">
            <column name="preset_code" type="TEXT"/>
        </addColumn>
    </changeSet>

</databaseChangeLog>
