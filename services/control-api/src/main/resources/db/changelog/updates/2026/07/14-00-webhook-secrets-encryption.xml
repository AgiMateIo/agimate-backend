<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <!-- Webhook-секреты переезжают из plaintext-колонок в envelope-шифрованный стор secrets:
         connections.webhook_secret -> secrets (entity=connection_webhook, owner=connection.id),
         agents.webhook_auth_header -> secrets (entity=agent_webhook_auth, owner=agent.id).
         Старые plaintext-колонки остаются до бэкфилла (LegacyPlaintextSecretMigration зануляет
         значения на старте); дропаются отдельной миграцией после подтверждения бэкфилла. -->
    <changeSet id="2026-07-14-00-webhook-secrets-encryption" author="agimate">
        <addColumn tableName="connections">
            <column name="webhook_secret_id" type="UUID">
                <constraints foreignKeyName="fk_connections_webhook_secret" references="secrets(id)"/>
            </column>
        </addColumn>
        <addColumn tableName="agents">
            <column name="webhook_auth_secret_id" type="UUID">
                <constraints foreignKeyName="fk_agents_webhook_auth_secret" references="secrets(id)"/>
            </column>
        </addColumn>
    </changeSet>
</databaseChangeLog>
