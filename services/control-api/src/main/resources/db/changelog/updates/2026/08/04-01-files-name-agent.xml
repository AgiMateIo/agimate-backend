<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
         http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.29.xsd">

    <!-- name: the file name as the producer knew it (an upload's original name, the name of an
         export). Nullable: ingest paths often have no name at all (a Telegram photo, a generated
         image), and inventing one would be indistinguishable from a real one.

         agent_id: the agent that PRODUCED the file — provenance, not an access boundary. Access
         stays user_id-wide on purpose: agents of one user hand agf_ ids to each other through board
         comments and sheet cells, and a per-agent gate would break that flow. Nullable because the
         producing agent is genuinely unknown on the ingest paths (a webhook downloads media before
         routing decides the recipients; a device or the webchat UI uploads outside any run).

         No FK to agents and no index: as with user_id, this table deliberately has neither — the row
         is swept on TTL independently of what it points at, and nothing queries files by agent yet. -->
    <changeSet id="files-add-name-and-agent" author="agimate">
        <addColumn tableName="files">
            <column name="name" type="TEXT"/>
            <column name="agent_id" type="UUID"/>
        </addColumn>
    </changeSet>

</databaseChangeLog>
