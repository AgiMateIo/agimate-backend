<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
         http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.29.xsd">

    <!--
      Денормализованный agent_id-FK создавался без onDelete — в отличие от всей остальной
      цепочки (channels/channel_sessions/messages.session_id каскадят по агенту). Из-за этого
      hard-delete агента (AgentService.delete) падал на fk_channel_session_messages_agent.
      Приводим FK к ON DELETE CASCADE: история чата эфемерна и должна уходить вместе с агентом.
    -->
    <changeSet id="channel-session-messages-agent-fk-cascade" author="agimate">
        <dropForeignKeyConstraint baseTableName="channel_session_messages"
                                  constraintName="fk_channel_session_messages_agent"/>

        <addForeignKeyConstraint baseTableName="channel_session_messages"
                                 baseColumnNames="agent_id"
                                 constraintName="fk_channel_session_messages_agent"
                                 referencedTableName="agents"
                                 referencedColumnNames="id"
                                 onDelete="CASCADE"/>
    </changeSet>

</databaseChangeLog>
