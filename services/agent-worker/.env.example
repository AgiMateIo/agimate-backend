# agent-worker configuration. Names follow Spring relaxed binding
# (agent.grpc.target -> AGENT_GRPC_TARGET). Copy to .env and fill in secrets.

# --- gRPC to control-api worker protocol (:9091) ---
AGENT_GRPC_TARGET=localhost:9091
# Plaintext (false) is allowed only for loopback targets; any remote target requires TLS.
AGENT_GRPC_USE_TLS=false
# AGENT_GRPC_CA_CERT=/path/to/ca.pem
# Worker-pool authkey (Bearer token) accepted by control-api's WorkerPoolAuthInterceptor.
AGENT_GRPC_AUTH_TOKEN=

# --- Agent identity ---
AGENT_AGENT_ID=agent-default

# --- Per-worker concurrency (concurrent model requests) ---
AGENT_CONCURRENCY_LLM=3

# --- Tool execution ---
# Poll budget for one backend tool call (Duration, e.g. 60s / 5m). Does not cancel the backend job.
AGENT_TOOL_POLL_TIMEOUT=60s
# Cap on one tool output (chars); longer output is cut with an explicit truncation marker.
AGENT_TOOL_MAX_OUTPUT_CHARS=64000

# --- User-facing notices ---
# Language of user-facing notices (BCP-47 tag). Bundled: en (default), ru; unknown → English.
AGENT_RESPONSE_LANGUAGE=en


# --- DBOS system database (must match control-api's dbos.system-database) ---
AGENT_DBOS_DATABASE_URL=jdbc:postgresql://localhost:5432/dbos
AGENT_DBOS_USERNAME=agimate
AGENT_DBOS_PASSWORD=agimate_dev_password
AGENT_DBOS_SCHEMA=dbos
# How long finished workflows (checkpoints included) are kept in the DBOS system database
# (Duration, e.g. 7d / 72h); 0 disables the purge. Business data lives in control-api anyway.
AGENT_DBOS_RETENTION=7d
