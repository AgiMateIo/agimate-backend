# agent-worker configuration. Names follow Spring relaxed binding
# (agent.grpc.target -> AGENT_GRPC_TARGET). Copy to .env and fill in secrets.

# --- gRPC to control-api worker protocol (:9091) ---
AGENT_GRPC_TARGET=localhost:9091
AGENT_GRPC_USE_TLS=false
# AGENT_GRPC_CA_CERT=/path/to/ca.pem
# Worker-pool authkey (Bearer token) accepted by control-api's WorkerPoolAuthInterceptor.
AGENT_GRPC_AUTH_TOKEN=

# --- Agent identity ---
AGENT_AGENT_ID=agent-default
AGENT_AGENT_WORKFLOW_ID=wf-default

# --- Per-worker concurrency (per-executor caps) ---
AGENT_CONCURRENCY_AGENT_RUNS=3
AGENT_CONCURRENCY_LLM=3
AGENT_CONCURRENCY_TOOL=8

# --- Tool execution ---
# Poll budget for one backend tool call (Duration, e.g. 60s / 5m). Does not cancel the backend job.
AGENT_TOOL_POLL_TIMEOUT=60s


# --- DBOS system database (must match control-api's dbos.system-database) ---
AGENT_DBOS_DATABASE_URL=jdbc:postgresql://localhost:5432/dbos_db
AGENT_DBOS_USERNAME=user
AGENT_DBOS_PASSWORD=password
AGENT_DBOS_SCHEMA=dbos
