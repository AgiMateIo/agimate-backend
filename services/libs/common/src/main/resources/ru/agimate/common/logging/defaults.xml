<?xml version="1.0" encoding="UTF-8"?>

<included>
    <include resource="org/springframework/boot/logging/logback/defaults.xml"/>
    <property resource="META-INF/build-info.properties"/>

    <springProperty scope="context" name="appName" source="spring.application.name"/>

    <!-- The format of CONSOLE_JSON below, read from the same Spring property Boot itself uses, so
         LOGGING_STRUCTURED_FORMAT_CONSOLE still switches ecs/logstash/gelf from the environment.

         Boot's own ${CONSOLE_LOG_STRUCTURED_FORMAT} cannot be used directly: its defaults.xml defines it
         as the empty string when the property is unset, StructuredLogEncoder only guards against null, so
         empty reaches the formatter factory and the whole Logback init throws — the service does not
         start. Nor is this a redefinition of that name: overriding it takes scope="local" to out-shadow
         Boot's own local property, which then silently depends on our include staying above it. A name of
         our own, tied to the appender it configures, has no such ordering to get wrong. -->
    <springProperty scope="context" name="CONSOLE_JSON_FORMAT" source="logging.structured.format.console"
                    defaultValue="ecs"/>

    <springProfile name="local">
        <appender name="CONSOLE_PRETTY_LOCAL" class="ch.qos.logback.core.ConsoleAppender">
            <encoder>
                <!--@formatter:off-->
				<pattern>%d{ISO8601} %boldCyan([%-10.10thread]) %highlight(%-5level) %magenta(%-20.28logger{36}:%-4.4line) - %replace(Request ID: [%X{x-request-id}]){'Request ID: \[\]', ''} %replace(run=[%X{run}] ){'run=\[\] ', ''}%msg%n</pattern>
				<!--@formatter:on-->
            </encoder>
        </appender>

        <root level="debug">
            <appender-ref ref="CONSOLE_PRETTY_LOCAL"/>
        </root>
    </springProfile>

    <!-- develop and test, spelled as a negation so that the three branches stay exhaustive: a profile
         that matches none of them would get no appender at all, and a service logging nothing is the
         one failure mode here that reports itself as success. -->
    <springProfile name="!local &amp; !prod">
        <appender name="CONSOLE_PRETTY" class="ch.qos.logback.core.ConsoleAppender">
            <encoder>
                <!--@formatter:off-->
				<pattern>%d{ISO8601} %boldCyan([%-10.10thread]) %highlight(%-5level) - %replace(Request ID: [%X{x-request-id}]){'Request ID: \[\]', ''} %replace(run=[%X{run}] ){'run=\[\] ', ''}%msg%n</pattern>
				<!--@formatter:on-->
            </encoder>
            <!-- No threshold filter on any appender here on purpose: one used to cut everything below
                 WARN, which silently overrode logging.level.* from the yamls — `ru.agimate: info` in
                 prod let the event through and the only appender dropped it. Levels are the one control. -->
        </appender>
        <root level="debug">
            <appender-ref ref="CONSOLE_PRETTY"/>
        </root>
    </springProfile>

    <!-- One JSON object per line, because that is what a log collector can index. Which JSON is a
         property, not a profile: logging.structured.format.console (ecs | logstash | gelf) is Boot's own
         knob and takes LOGGING_STRUCTURED_FORMAT_CONSOLE from the environment, so a collector swap needs
         no release. A `log-<format>` profile would be a second mechanism for the same one string.

         ECS: MDC entries become top-level fields, so `run` (an agent run) and `jobKey` (a connector job)
         are queryable instead of being a prefix on the message; service.name comes from
         spring.application.name. The pattern above also reads %X{x-request-id}, which resolves to
         nothing — RequestIdFilter puts that id under the key `X-Request-ID` and is not registered in any
         service anyway. Left as is: fixing the key would only surface an id nobody sets. -->

    <springProfile name="prod">
        <appender name="CONSOLE_JSON" class="ch.qos.logback.core.ConsoleAppender">
            <encoder class="org.springframework.boot.logging.logback.StructuredLogEncoder">
                <format>${CONSOLE_JSON_FORMAT}</format>
                <charset>${CONSOLE_LOG_CHARSET}</charset>
            </encoder>
        </appender>
        <root level="debug">
            <appender-ref ref="CONSOLE_JSON"/>
        </root>
    </springProfile>

</included>
