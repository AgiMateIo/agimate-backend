<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
         http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.29.xsd">

    <!-- A password is one per person, which is why it lives in users rather than in a table of its
         own: a second table here would be a one-to-one table. Its absence is the absence of the
         column value — no "has a password" flag, because two sources of one truth drift apart.

         The hash carries its algorithm as a prefix ({bcrypt}…), so replacing the algorithm later is
         a matter of re-encoding on the next successful login and not of a migration. -->
    <changeSet id="add-password-to-users" author="Eugene Smith">
        <addColumn tableName="users">
            <column name="password_hash" type="TEXT"/>
            <!-- What the account's list of login methods shows beside the password entry. -->
            <column name="password_updated_at" type="TIMESTAMP"/>
        </addColumn>
    </changeSet>

    <!-- One-time secrets that travel by mail. Only the hash is stored: a letter in flight must not
         be redeemable from a dump of this table, and the token itself exists in the mailbox alone.

         used_at is kept rather than the row deleted, for the same reason as in auth_codes — until
         the sweep removes it, a second attempt is answered "already used" instead of being
         indistinguishable from a typo.

         purpose discriminates what the token buys. Today there is one value; the tickets that bind
         an OAuth provider to an account you are already signed into land here as a second one. -->
    <changeSet id="create-auth-tokens-table" author="Eugene Smith">
        <createTable tableName="auth_tokens">
            <column name="id" type="UUID" defaultValueComputed="uuidv7()">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="created_at" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="purpose" type="TEXT">
                <constraints nullable="false"/>
            </column>
            <column name="user_id" type="UUID">
                <constraints nullable="false"/>
            </column>
            <column name="token_hash" type="TEXT">
                <constraints nullable="false" unique="true"
                             uniqueConstraintName="uq_auth_tokens_token_hash"/>
            </column>
            <column name="expires_at" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="used_at" type="TIMESTAMP"/>
        </createTable>

        <addForeignKeyConstraint
                baseTableName="auth_tokens"
                baseColumnNames="user_id"
                constraintName="fk_auth_tokens_user"
                referencedTableName="users"
                referencedColumnNames="id"
                onDelete="CASCADE"/>

        <!-- Serves both readers: how recently a letter went out to this person (the throttle) and
             which live tokens a new request has to spend. Covers user_id for the cascade too, so a
             separate index on it would only be this one's prefix. -->
        <createIndex tableName="auth_tokens" indexName="idx_auth_tokens_user_id_purpose">
            <column name="user_id"/>
            <column name="purpose"/>
        </createIndex>

        <sql>
            ALTER TABLE auth_tokens ADD CONSTRAINT chk_auth_tokens_purpose
            CHECK (purpose IN ('PASSWORD_RESET'));
        </sql>
    </changeSet>

    <!-- A password change ends every other session, and why a session ended is worth telling apart
         in an incident. The constraint has to be recreated for the new value to be storable at all —
         a check constraint is what a status enum is guarded by here. -->
    <changeSet id="add-password-changed-revoke-reason" author="Eugene Smith">
        <sql>
            ALTER TABLE auth_sessions DROP CONSTRAINT chk_auth_sessions_revoke_reason;
        </sql>
        <sql>
            ALTER TABLE auth_sessions ADD CONSTRAINT chk_auth_sessions_revoke_reason
            CHECK (revoke_reason IS NULL
                   OR revoke_reason IN ('LOGOUT', 'REPLAY', 'REVOKED', 'PASSWORD_CHANGED'));
        </sql>
    </changeSet>

</databaseChangeLog>
