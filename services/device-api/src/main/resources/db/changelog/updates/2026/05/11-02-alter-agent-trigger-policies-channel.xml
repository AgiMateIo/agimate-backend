<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
         http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.29.xsd">

    <changeSet id="alter-agent-trigger-policies-add-channel" author="agimate">
        <addColumn tableName="agent_trigger_policies">
            <column name="channel_id" type="BIGINT"/>
            <column name="input_filter" type="JSONB"/>
        </addColumn>

        <addForeignKeyConstraint baseTableName="agent_trigger_policies"
                                 baseColumnNames="channel_id"
                                 constraintName="fk_agent_trigger_policies_channel"
                                 referencedTableName="channels"
                                 referencedColumnNames="id"
                                 onDelete="CASCADE"/>

        <createIndex tableName="agent_trigger_policies" indexName="idx_agent_trigger_policies_channel_id">
            <column name="channel_id"/>
        </createIndex>
    </changeSet>

</databaseChangeLog>
