<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="20-04-add-agentic-team-id-to-agent-settings" author="agimate">
        <addColumn tableName="agent_settings">
            <column name="agentic_team_id" type="BIGINT">
                <constraints foreignKeyName="fk_agent_settings_agentic_team"
                             references="agentic_teams(id)"/>
            </column>
        </addColumn>

        <createIndex tableName="agent_settings" indexName="idx_agent_settings_agentic_team_id">
            <column name="agentic_team_id"/>
        </createIndex>
    </changeSet>

</databaseChangeLog>
