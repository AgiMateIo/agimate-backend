<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
         http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.29.xsd">

    <changeSet id="add-source-to-agent-tool-policies" author="agimate">
        <addColumn tableName="agent_tool_policies">
            <column name="source" type="TEXT"/>
        </addColumn>
    </changeSet>

    <changeSet id="add-source-to-agent-trigger-policies" author="agimate">
        <addColumn tableName="agent_trigger_policies">
            <column name="source" type="TEXT"/>
        </addColumn>
    </changeSet>

    <changeSet id="add-installed-skill-version-to-agent-skills" author="agimate">
        <addColumn tableName="agent_skills">
            <column name="installed_skill_version" type="INTEGER"/>
        </addColumn>
    </changeSet>

</databaseChangeLog>
