<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
         http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.29.xsd">

    <changeSet id="merge-device-into-apps" author="agimate">
        <!-- 1. Add device columns to device_auth_keys -->
        <addColumn tableName="device_auth_keys">
            <column name="device_id" type="TEXT"/>
            <column name="device_features" type="JSONB"/>
            <column name="triggers" type="JSONB"/>
            <column name="tools" type="JSONB"/>
        </addColumn>

        <!-- 2. Drop FK and index from device table -->
        <dropForeignKeyConstraint baseTableName="device" constraintName="fk_device_device_auth_key"/>
        <dropIndex tableName="device" indexName="idx_device_auth_key_id"/>

        <!-- 3. Drop device table -->
        <dropTable tableName="device"/>

        <!-- 4. Drop FK in trigger_logs referencing device_auth_keys -->
        <dropForeignKeyConstraint baseTableName="trigger_logs" constraintName="fk_trigger_logs_device_auth_key"/>
        <dropIndex tableName="trigger_logs" indexName="idx_trigger_logs_device_auth_key_id"/>

        <!-- 5. Rename device_auth_keys → apps -->
        <renameTable oldTableName="device_auth_keys" newTableName="apps"/>

        <!-- 6. Recreate indexes with idx_apps_* names -->
        <dropIndex tableName="apps" indexName="idx_device_auth_keys_user_pub_id"/>
        <createIndex tableName="apps" indexName="idx_apps_user_pub_id">
            <column name="user_pub_id"/>
        </createIndex>

        <dropIndex tableName="apps" indexName="idx_device_auth_keys_key_id_active"/>
        <createIndex tableName="apps" indexName="idx_apps_key_id_active">
            <column name="key_id"/>
            <column name="enabled"/>
            <column name="deleted_at"/>
        </createIndex>

        <!-- 7. Add index on (device_id, user_pub_id) -->
        <createIndex tableName="apps" indexName="idx_apps_device_id_user_pub_id">
            <column name="device_id"/>
            <column name="user_pub_id"/>
        </createIndex>

        <!-- 8. Recreate FK in trigger_logs referencing apps -->
        <createIndex tableName="trigger_logs" indexName="idx_trigger_logs_app_id">
            <column name="device_auth_key_id"/>
        </createIndex>

        <addForeignKeyConstraint
                baseTableName="trigger_logs"
                baseColumnNames="device_auth_key_id"
                constraintName="fk_trigger_logs_app"
                referencedTableName="apps"
                referencedColumnNames="id"/>
    </changeSet>

</databaseChangeLog>
