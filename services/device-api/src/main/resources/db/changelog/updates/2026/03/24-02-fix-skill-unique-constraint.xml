<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
         http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.29.xsd">

    <changeSet id="fix-skill-unique-constraint-for-soft-delete" author="agimate">
        <dropUniqueConstraint tableName="skills" constraintName="uq_skills_user_pub_id_name"/>
        <sql>CREATE UNIQUE INDEX uq_skills_user_name_active ON skills (user_pub_id, name) WHERE deleted_at IS NULL</sql>
    </changeSet>

</databaseChangeLog>
