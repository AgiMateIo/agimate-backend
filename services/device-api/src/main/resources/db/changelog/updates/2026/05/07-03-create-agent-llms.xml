<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
         http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.29.xsd">

    <changeSet id="create-agent-llms-table" author="agimate">
        <createTable tableName="agent_llms">
            <column name="id" type="BIGSERIAL" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="pub_id" type="UUID">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="user_pub_id" type="UUID">
                <constraints nullable="false"/>
            </column>
            <column name="agent_pub_id" type="UUID">
                <constraints nullable="false"/>
            </column>
            <column name="llm_provider_pub_id" type="UUID">
                <constraints nullable="false"/>
            </column>
            <column name="name" type="TEXT">
                <constraints nullable="false"/>
            </column>
            <column name="model" type="TEXT">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <addUniqueConstraint tableName="agent_llms"
                             columnNames="agent_pub_id, name"
                             constraintName="uq_agent_llms_agent_name"/>

        <addForeignKeyConstraint baseTableName="agent_llms"
                                 baseColumnNames="agent_pub_id"
                                 constraintName="fk_agent_llms_agent"
                                 referencedTableName="agents"
                                 referencedColumnNames="pub_id"
                                 onDelete="CASCADE"/>

        <addForeignKeyConstraint baseTableName="agent_llms"
                                 baseColumnNames="llm_provider_pub_id"
                                 constraintName="fk_agent_llms_llm_provider"
                                 referencedTableName="llm_providers"
                                 referencedColumnNames="pub_id"
                                 onDelete="CASCADE"/>

        <createIndex tableName="agent_llms" indexName="idx_agent_llms_user_pub_id">
            <column name="user_pub_id"/>
        </createIndex>
        <createIndex tableName="agent_llms" indexName="idx_agent_llms_llm_provider_pub_id">
            <column name="llm_provider_pub_id"/>
        </createIndex>
    </changeSet>

</databaseChangeLog>
