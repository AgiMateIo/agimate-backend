<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
         http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.29.xsd">

    <!--
      Turns trigger_log_agents into the active-run registry (AgentRunRegistry).
      Each row is an agent run; pub_id is the canonical run_id (== DBOS workflow_id).
      Adds run lifecycle (status), session linkage and a TTL backstop, and enforces
      the single-writer-per-session invariant via a partial unique index.
    -->
    <changeSet id="trigger-log-agents-add-run-registry-columns" author="agimate">
        <addColumn tableName="trigger_log_agents">
            <column name="session_pub_id" type="UUID"/>
            <column name="status" type="TEXT" defaultValue="ENQUEUED">
                <constraints nullable="false"/>
            </column>
            <column name="expires_at" type="TIMESTAMP"/>
        </addColumn>

        <sql>
            ALTER TABLE trigger_log_agents
                ADD CONSTRAINT chk_trigger_log_agents_status
                CHECK (status IN ('ENQUEUED', 'RUNNING', 'DONE', 'FAILED', 'CANCELLED'))
        </sql>

        <!-- Backfill historical rows: they are completed runs, not enqueued. -->
        <sql>
            UPDATE trigger_log_agents
            SET status = CASE WHEN error IS NOT NULL THEN 'FAILED' ELSE 'DONE' END
            WHERE status = 'ENQUEUED'
        </sql>

        <!-- Single active writer per session: at most one RUNNING run per session. -->
        <sql>
            CREATE UNIQUE INDEX uq_trigger_log_agents_active_session
                ON trigger_log_agents (session_pub_id)
                WHERE session_pub_id IS NOT NULL AND status = 'RUNNING'
        </sql>
    </changeSet>

</databaseChangeLog>
