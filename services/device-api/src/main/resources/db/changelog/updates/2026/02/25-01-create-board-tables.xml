<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
         http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.29.xsd">

    <changeSet id="create-boards-table" author="agimate">
        <createTable tableName="boards">
            <column name="id" type="BIGSERIAL" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="pub_id" type="UUID" defaultValueComputed="gen_random_uuid()">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="user_pub_id" type="UUID">
                <constraints nullable="false"/>
            </column>
            <column name="agentic_team_id" type="BIGINT">
                <constraints nullable="false" unique="true"
                             foreignKeyName="fk_boards_agentic_team"
                             references="agentic_teams(id)"/>
            </column>
            <column name="name" type="TEXT">
                <constraints nullable="false"/>
            </column>
            <column name="description" type="TEXT"/>
            <column name="created_at" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <createIndex tableName="boards" indexName="idx_boards_user_pub_id">
            <column name="user_pub_id"/>
        </createIndex>
    </changeSet>

    <changeSet id="create-board-tasks-table" author="agimate">
        <createTable tableName="board_tasks">
            <column name="id" type="BIGSERIAL" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="pub_id" type="UUID" defaultValueComputed="gen_random_uuid()">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="board_id" type="BIGINT">
                <constraints nullable="false"
                             foreignKeyName="fk_board_tasks_board"
                             references="boards(id)"/>
            </column>
            <column name="user_pub_id" type="UUID">
                <constraints nullable="false"/>
            </column>
            <column name="parent_task_id" type="BIGINT">
                <constraints foreignKeyName="fk_board_tasks_parent"
                             references="board_tasks(id)"/>
            </column>
            <column name="type" type="TEXT">
                <constraints nullable="false"/>
            </column>
            <column name="status" type="TEXT" defaultValue="BACKLOG">
                <constraints nullable="false"/>
            </column>
            <column name="title" type="TEXT">
                <constraints nullable="false"/>
            </column>
            <column name="description" type="TEXT"/>
            <column name="created_by_agent_id" type="BIGINT">
                <constraints nullable="false"
                             foreignKeyName="fk_board_tasks_created_by_agent"
                             references="agents(id)"/>
            </column>
            <column name="assignee_agent_id" type="BIGINT">
                <constraints foreignKeyName="fk_board_tasks_assignee_agent"
                             references="agents(id)"/>
            </column>
            <column name="created_at" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <createIndex tableName="board_tasks" indexName="idx_board_tasks_board_id">
            <column name="board_id"/>
        </createIndex>

        <createIndex tableName="board_tasks" indexName="idx_board_tasks_parent_task_id">
            <column name="parent_task_id"/>
        </createIndex>

        <createIndex tableName="board_tasks" indexName="idx_board_tasks_status">
            <column name="status"/>
        </createIndex>

        <createIndex tableName="board_tasks" indexName="idx_board_tasks_assignee_agent_id">
            <column name="assignee_agent_id"/>
        </createIndex>
    </changeSet>

    <changeSet id="create-board-task-comments-table" author="agimate">
        <createTable tableName="board_task_comments">
            <column name="id" type="BIGSERIAL" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="pub_id" type="UUID" defaultValueComputed="gen_random_uuid()">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="board_task_id" type="BIGINT">
                <constraints nullable="false"
                             foreignKeyName="fk_board_task_comments_task"
                             references="board_tasks(id)"/>
            </column>
            <column name="user_pub_id" type="UUID">
                <constraints nullable="false"/>
            </column>
            <column name="agent_id" type="BIGINT">
                <constraints nullable="false"
                             foreignKeyName="fk_board_task_comments_agent"
                             references="agents(id)"/>
            </column>
            <column name="content" type="TEXT">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <createIndex tableName="board_task_comments" indexName="idx_board_task_comments_task_id">
            <column name="board_task_id"/>
        </createIndex>

        <createIndex tableName="board_task_comments" indexName="idx_board_task_comments_created_at">
            <column name="created_at" descending="true"/>
        </createIndex>
    </changeSet>

</databaseChangeLog>
