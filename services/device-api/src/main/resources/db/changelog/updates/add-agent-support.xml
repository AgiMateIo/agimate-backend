<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="create-tool-use-logs-table" author="agimate">
        <createTable tableName="tool_use_logs">
            <column name="id" type="BIGSERIAL" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="pub_id" type="UUID" defaultValueComputed="gen_random_uuid()">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="api_key_pub_id" type="UUID">
                <constraints nullable="false"/>
            </column>
            <column name="tool_use_id" type="TEXT">
                <constraints nullable="false"/>
            </column>
            <column name="tool_name" type="TEXT">
                <constraints nullable="false"/>
            </column>
            <column name="device_auth_key_id" type="TEXT"/>
            <column name="tool_params" type="JSONB"/>
            <column name="result_at" type="TIMESTAMP"/>
            <column name="result" type="TEXT"/>
            <column name="error" type="TEXT"/>
            <column name="created_at" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <createIndex tableName="tool_use_logs" indexName="idx_tool_use_logs_api_key_pub_id">
            <column name="api_key_pub_id"/>
        </createIndex>

        <createIndex tableName="tool_use_logs" indexName="idx_tool_use_logs_created_at">
            <column name="created_at" descending="true"/>
        </createIndex>

        <createIndex tableName="tool_use_logs" indexName="idx_tool_use_logs_tool_use_id">
            <column name="tool_use_id"/>
        </createIndex>
    </changeSet>

    <changeSet id="create-agent-settings-table" author="agimate">
        <createTable tableName="agent_settings">
            <column name="id" type="BIGSERIAL" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="pub_id" type="UUID" defaultValueComputed="gen_random_uuid()">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="api_key_pub_id" type="UUID">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="user_pub_id" type="UUID">
                <constraints nullable="false"/>
            </column>
            <column name="prompt" type="TEXT"/>
            <column name="triggers_allow_all" type="BOOLEAN" defaultValueBoolean="false">
                <constraints nullable="false"/>
            </column>
            <column name="triggers_to" type="TEXT" defaultValue="ignore">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <createIndex tableName="agent_settings" indexName="idx_agent_settings_user_pub_id">
            <column name="user_pub_id"/>
        </createIndex>
    </changeSet>

    <changeSet id="create-agent-tools-table" author="agimate">
        <createTable tableName="agent_tools">
            <column name="id" type="BIGSERIAL" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="user_pub_id" type="UUID">
                <constraints nullable="false"/>
            </column>
            <column name="api_key_pub_id" type="UUID">
                <constraints nullable="false"/>
            </column>
            <column name="tool_name" type="TEXT">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <addUniqueConstraint tableName="agent_tools"
                             columnNames="api_key_pub_id, tool_name"
                             constraintName="uq_agent_tools_api_key_pub_id_tool_name"/>
    </changeSet>

    <changeSet id="create-agent-triggers-table" author="agimate">
        <createTable tableName="agent_triggers">
            <column name="id" type="BIGSERIAL" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="user_pub_id" type="UUID">
                <constraints nullable="false"/>
            </column>
            <column name="api_key_pub_id" type="UUID">
                <constraints nullable="false"/>
            </column>
            <column name="trigger_name" type="TEXT">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <addUniqueConstraint tableName="agent_triggers"
                             columnNames="api_key_pub_id, trigger_name"
                             constraintName="uq_agent_triggers_api_key_pub_id_trigger_name"/>
    </changeSet>

    <changeSet id="add-routed-to-to-trigger-logs" author="agimate">
        <addColumn tableName="trigger_logs">
            <column name="routed_to" type="TEXT"/>
        </addColumn>
    </changeSet>

</databaseChangeLog>
