<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                   http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="06-02-integration-credentials-unique" author="agimate">
        <dropUniqueConstraint tableName="integration_credentials"
                              constraintName="uq_integration_credentials_connector_code"/>

        <addUniqueConstraint tableName="integration_credentials"
                             columnNames="connector_code, user_pub_id, platform_identifier"
                             constraintName="uq_integration_credentials_connector_user_identifier"/>
    </changeSet>

</databaseChangeLog>
