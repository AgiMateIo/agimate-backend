<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
         http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.29.xsd">

    <changeSet id="create-channel-sessions-table" author="agimate">
        <createTable tableName="channel_sessions">
            <column name="id" type="BIGSERIAL" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="pub_id" type="UUID">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="channel_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="title" type="TEXT"/>
            <column name="last_message_at" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="closed_at" type="TIMESTAMP"/>
            <column name="created_at" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <addForeignKeyConstraint baseTableName="channel_sessions"
                                 baseColumnNames="channel_id"
                                 constraintName="fk_channel_sessions_channel"
                                 referencedTableName="channels"
                                 referencedColumnNames="id"
                                 onDelete="CASCADE"/>

        <createIndex tableName="channel_sessions" indexName="idx_channel_sessions_channel_id">
            <column name="channel_id"/>
        </createIndex>
        <createIndex tableName="channel_sessions" indexName="idx_channel_sessions_channel_active">
            <column name="channel_id"/>
            <column name="last_message_at" descending="true"/>
        </createIndex>
    </changeSet>

</databaseChangeLog>
