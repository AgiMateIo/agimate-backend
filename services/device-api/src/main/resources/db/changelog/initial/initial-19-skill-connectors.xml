<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
         http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.29.xsd">

    <changeSet id="create-skill-connectors-table" author="agimate">
        <createTable tableName="skill_connectors">
            <column name="id" type="UUID" defaultValueComputed="uuidv7()">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="skill_id" type="UUID">
                <constraints nullable="false"
                             foreignKeyName="fk_skill_connectors_skill"
                             references="skills(id)"
                             deleteCascade="true"/>
            </column>
            <column name="user_pub_id" type="UUID">
                <constraints nullable="false"/>
            </column>
            <column name="connector_code" type="TEXT">
                <constraints nullable="false"/>
            </column>
            <column name="type" type="TEXT"/>
            <column name="name" type="TEXT"/>
            <column name="created_at" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <sql>ALTER TABLE skill_connectors ADD CONSTRAINT chk_skill_connectors_type CHECK (type IS NULL OR type IN ('TOOL', 'TRIGGER'))</sql>
        <sql>ALTER TABLE skill_connectors ADD CONSTRAINT chk_skill_connectors_type_name CHECK (type IS NOT NULL OR name IS NULL)</sql>
        <sql>CREATE UNIQUE INDEX uq_skill_connectors ON skill_connectors (skill_id, connector_code, COALESCE(type, ''), COALESCE(name, ''))</sql>

        <createIndex tableName="skill_connectors" indexName="idx_skill_connectors_user_pub_id">
            <column name="user_pub_id"/>
        </createIndex>
    </changeSet>

</databaseChangeLog>
