        </createTable>

        <createIndex tableName="webhook_delivery_logs" indexName="idx_webhook_delivery_logs_trigger_log_agent_id">
            <column name="trigger_log_agent_id"/>
        </createIndex>

        <createIndex tableName="webhook_delivery_logs" indexName="idx_webhook_delivery_logs_delivered_at">
            <column name="delivered_at" descending="true"/>
        </createIndex>
    </changeSet>

    <!-- ===================== -->
    <!-- tool_use_logs         -->
    <!-- ===================== -->
    <changeSet id="create-tool-use-logs-table" author="agimate">
        <createTable tableName="tool_use_logs">
            <column name="id" type="BIGSERIAL" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="pub_id" type="UUID" defaultValueComputed="gen_random_uuid()">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="user_pub_id" type="UUID">
                <constraints nullable="false"/>
            </column>
            <column name="api_key_pub_id" type="UUID">
