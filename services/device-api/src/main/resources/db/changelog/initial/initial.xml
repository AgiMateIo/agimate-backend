        <createIndex tableName="tool_use_logs" indexName="idx_tool_use_logs_user_pub_id">
            <column name="user_pub_id"/>
        </createIndex>

        <createIndex tableName="tool_use_logs" indexName="idx_tool_use_logs_api_key_pub_id">
            <column name="api_key_pub_id"/>
        </createIndex>

        <createIndex tableName="tool_use_logs" indexName="idx_tool_use_logs_created_at">
            <column name="created_at" descending="true"/>
        </createIndex>

        <createIndex tableName="tool_use_logs" indexName="idx_tool_use_logs_tool_use_id">
            <column name="tool_use_id"/>
        </createIndex>
    </changeSet>

    <!-- ===================== -->
    <!-- boards                -->
    <!-- ===================== -->
    <changeSet id="create-boards-table" author="agimate">
        <createTable tableName="boards">
            <column name="id" type="BIGSERIAL" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="pub_id" type="UUID" defaultValueComputed="gen_random_uuid()">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="user_pub_id" type="UUID">
                <constraints nullable="false"/>
            </column>
            <column name="agentic_team_id" type="BIGINT">
                <constraints nullable="false" unique="true"
                             foreignKeyName="fk_boards_agentic_team"
                             references="agentic_teams(id)"/>
            </column>
            <column name="name" type="TEXT">
                <constraints nullable="false"/>
            </column>
            <column name="description" type="TEXT"/>
            <column name="created_at" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP">
