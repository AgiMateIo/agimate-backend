<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
         http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.29.xsd">

    <!-- ===================== -->
    <!-- connector_registry    -->
    <!-- ===================== -->
    <changeSet id="create-connector-registry-table" author="agimate">
        <createTable tableName="connector_registry">
            <column name="id" type="BIGSERIAL" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="pub_id" type="UUID" defaultValueComputed="gen_random_uuid()">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="code" type="TEXT">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="type" type="TEXT">
                <constraints nullable="false"/>
            </column>
            <column name="title" type="TEXT">
                <constraints nullable="false"/>
            </column>
            <column name="description" type="TEXT"/>
            <column name="user_pub_id" type="UUID">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <sql>
            ALTER TABLE connector_registry
                ADD CONSTRAINT chk_connector_registry_code CHECK (code ~ '^[a-z0-9\-]{3,64}$');
            ALTER TABLE connector_registry
                ADD CONSTRAINT chk_connector_registry_type CHECK (type IN ('APP', 'INTEGRATION', 'INTERNAL_SERVICE', 'LOOPBACK'));
        </sql>

        <createIndex tableName="connector_registry" indexName="idx_connector_registry_user_pub_id">
            <column name="user_pub_id"/>
        </createIndex>
    </changeSet>

    <!-- ===================== -->
    <!-- apps (was connectors) -->
    <!-- ===================== -->
    <changeSet id="create-apps-table" author="agimate">
        <createTable tableName="apps">
            <column name="id" type="BIGSERIAL" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="pub_id" type="UUID" defaultValueComputed="gen_random_uuid()">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="connector_registry_id" type="BIGINT">
                <constraints nullable="false"
                             foreignKeyName="fk_apps_connector_registry"
                             references="connector_registry(id)"/>
            </column>
            <column name="user_pub_id" type="UUID">
                <constraints nullable="false"/>
            </column>
            <column name="name" type="TEXT">
                <constraints nullable="false"/>
            </column>
            <column name="description" type="TEXT"/>
            <column name="key_hash" type="TEXT">
                <constraints nullable="false"/>
            </column>
            <column name="key_id" type="TEXT">
                <constraints nullable="false"/>
            </column>
            <column name="enabled" type="BOOLEAN" defaultValueBoolean="true">
                <constraints nullable="false"/>
            </column>
            <column name="deleted_at" type="TIMESTAMP"/>
            <column name="device_id" type="TEXT"/>
            <column name="info" type="JSONB"/>
            <column name="triggers" type="JSONB"/>
            <column name="tools" type="JSONB"/>
            <column name="created_at" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <createIndex tableName="apps" indexName="idx_apps_user_pub_id">
            <column name="user_pub_id"/>
        </createIndex>

        <createIndex tableName="apps" indexName="idx_apps_key_id_active">
            <column name="key_id"/>
            <column name="enabled"/>
            <column name="deleted_at"/>
        </createIndex>

        <createIndex tableName="apps" indexName="idx_apps_device_id_user_pub_id">
            <column name="device_id"/>
            <column name="user_pub_id"/>
        </createIndex>

        <createIndex tableName="apps" indexName="idx_apps_connector_registry_id">
            <column name="connector_registry_id"/>
        </createIndex>
    </changeSet>

    <!-- ===================== -->
    <!-- platforms             -->
    <!-- ===================== -->
    <changeSet id="create-platforms-table" author="agimate">
        <createTable tableName="platforms">
            <column name="id" type="BIGSERIAL" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="pub_id" type="UUID" defaultValueComputed="gen_random_uuid()">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="code" type="TEXT">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="name" type="TEXT">
                <constraints nullable="false"/>
            </column>
            <column name="description" type="TEXT"/>
            <column name="icon_url" type="TEXT"/>
            <column name="category" type="TEXT">
                <constraints nullable="false"/>
            </column>
            <column name="credential_fields" type="JSONB">
                <constraints nullable="false"/>
            </column>
            <column name="supports_webhooks" type="BOOLEAN" defaultValueBoolean="false">
                <constraints nullable="false"/>
            </column>
            <column name="enabled" type="BOOLEAN" defaultValueBoolean="true">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <insert tableName="platforms">
            <column name="code" value="telegram"/>
            <column name="name" value="Telegram"/>
            <column name="description" value="Connect a Telegram bot"/>
            <column name="category" value="messaging"/>
            <column name="credential_fields" value='["token"]'/>
            <column name="supports_webhooks" valueBoolean="true"/>
        </insert>
    </changeSet>

    <!-- ================================ -->
    <!-- integration_credentials (was integrations) -->
    <!-- ================================ -->
    <changeSet id="create-integration-credentials-table" author="agimate">
        <createTable tableName="integration_credentials">
            <column name="id" type="BIGSERIAL" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="pub_id" type="UUID" defaultValueComputed="gen_random_uuid()">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="connector_registry_id" type="BIGINT">
                <constraints nullable="false"
                             foreignKeyName="fk_integration_credentials_connector_registry"
                             references="connector_registry(id)"/>
            </column>
            <column name="platform_id" type="BIGINT">
                <constraints nullable="false"
                             foreignKeyName="fk_integration_credentials_platform"
                             references="platforms(id)"/>
            </column>
            <column name="user_pub_id" type="UUID">
                <constraints nullable="false"/>
            </column>
            <column name="name" type="TEXT"/>
            <column name="platform_identifier" type="TEXT">
                <constraints nullable="false"/>
            </column>
            <column name="encrypted_data" type="TEXT">
                <constraints nullable="false"/>
            </column>
            <column name="webhook_secret" type="TEXT"/>
            <column name="enabled" type="BOOLEAN" defaultValueBoolean="true">
                <constraints nullable="false"/>
            </column>
            <column name="last_used_at" type="TIMESTAMP"/>
            <column name="deleted_at" type="TIMESTAMP"/>
            <column name="created_at" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <addUniqueConstraint tableName="integration_credentials"
                             columnNames="user_pub_id, platform_id, platform_identifier"
                             constraintName="uq_integration_credentials_user_platform"/>

        <createIndex tableName="integration_credentials" indexName="idx_integration_credentials_user_pub_id">
            <column name="user_pub_id"/>
        </createIndex>

        <createIndex tableName="integration_credentials" indexName="idx_integration_credentials_connector_registry_id">
            <column name="connector_registry_id"/>
        </createIndex>
    </changeSet>

    <!-- ===================== -->
    <!-- agentic_teams         -->
    <!-- ===================== -->
    <changeSet id="create-agentic-teams-table" author="agimate">
        <createTable tableName="agentic_teams">
            <column name="id" type="BIGSERIAL" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="pub_id" type="UUID">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="name" type="TEXT">
                <constraints nullable="false"/>
            </column>
            <column name="description" type="TEXT"/>
            <column name="user_pub_id" type="UUID">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <addUniqueConstraint tableName="agentic_teams"
                             columnNames="user_pub_id, name"
                             constraintName="uq_agentic_teams_user_pub_id_name"/>

        <createIndex tableName="agentic_teams" indexName="idx_agentic_teams_user_pub_id">
            <column name="user_pub_id"/>
        </createIndex>
    </changeSet>

    <!-- ===================== -->
    <!-- agents                -->
    <!-- ===================== -->
    <changeSet id="create-agents-table" author="agimate">
        <createTable tableName="agents">
            <column name="id" type="BIGSERIAL" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="pub_id" type="UUID" defaultValueComputed="gen_random_uuid()">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="api_key_pub_id" type="UUID">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="user_pub_id" type="UUID">
                <constraints nullable="false"/>
            </column>
            <column name="name" type="TEXT" defaultValue="Unnamed Agent">
                <constraints nullable="false"/>
            </column>
            <column name="prompt" type="TEXT"/>
            <column name="triggers_allow_all" type="BOOLEAN" defaultValueBoolean="false">
                <constraints nullable="false"/>
            </column>
            <column name="triggers_to" type="TEXT" defaultValue="ignore">
                <constraints nullable="false"/>
            </column>
            <column name="webhook_url" type="TEXT"/>
            <column name="webhook_auth_header" type="TEXT"/>
            <column name="agentic_team_id" type="BIGINT">
                <constraints foreignKeyName="fk_agents_agentic_team"
                             references="agentic_teams(id)"/>
            </column>
            <column name="created_at" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <createIndex tableName="agents" indexName="idx_agents_user_pub_id">
            <column name="user_pub_id"/>
        </createIndex>

        <createIndex tableName="agents" indexName="idx_agents_agentic_team_id">
            <column name="agentic_team_id"/>
        </createIndex>
    </changeSet>

    <!-- ============================= -->
    <!-- agent_tool_policies (ABAC)    -->
    <!-- ============================= -->
    <changeSet id="create-agent-tool-policies-table" author="agimate">
        <createTable tableName="agent_tool_policies">
            <column name="id" type="UUID" defaultValueComputed="gen_random_uuid()">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="api_key_pub_id" type="UUID">
                <constraints nullable="false"/>
            </column>
            <column name="connector_name" type="TEXT"/>
            <column name="connector_identity" type="TEXT"/>
            <column name="tool_name" type="TEXT"/>
            <column name="effect" type="TEXT">
                <constraints nullable="false"/>
            </column>
            <column name="priority" type="INTEGER"/>
            <column name="description" type="TEXT"/>
            <column name="created_at" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <sql>
            ALTER TABLE agent_tool_policies
                ADD CONSTRAINT chk_agent_tool_policies_effect CHECK (effect IN ('ALLOW', 'DENY'));
            ALTER TABLE agent_tool_policies
                ADD CONSTRAINT chk_agent_tool_policies_identity_requires_connector CHECK (connector_identity IS NULL OR connector_name IS NOT NULL);
            ALTER TABLE agent_tool_policies
                ADD CONSTRAINT chk_agent_tool_policies_tool_requires_connector CHECK (tool_name IS NULL OR connector_name IS NOT NULL);
        </sql>

        <addUniqueConstraint tableName="agent_tool_policies"
                             columnNames="api_key_pub_id, connector_name, connector_identity, tool_name, effect"
                             constraintName="uq_agent_tool_policies_composite"/>

        <createIndex tableName="agent_tool_policies" indexName="idx_agent_tool_policies_api_key">
            <column name="api_key_pub_id"/>
        </createIndex>

        <createIndex tableName="agent_tool_policies" indexName="idx_agent_tool_policies_lookup">
            <column name="api_key_pub_id"/>
            <column name="connector_name"/>
            <column name="connector_identity"/>
            <column name="tool_name"/>
        </createIndex>
    </changeSet>

    <!-- ================================ -->
    <!-- agent_trigger_policies (ABAC)    -->
    <!-- ================================ -->
    <changeSet id="create-agent-trigger-policies-table" author="agimate">
        <createTable tableName="agent_trigger_policies">
            <column name="id" type="UUID" defaultValueComputed="gen_random_uuid()">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="api_key_pub_id" type="UUID">
                <constraints nullable="false"/>
            </column>
            <column name="connector_name" type="TEXT"/>
            <column name="connector_identity" type="TEXT"/>
            <column name="trigger_name" type="TEXT"/>
            <column name="effect" type="TEXT">
                <constraints nullable="false"/>
            </column>
            <column name="priority" type="INTEGER"/>
            <column name="description" type="TEXT"/>
            <column name="created_at" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <sql>
            ALTER TABLE agent_trigger_policies
                ADD CONSTRAINT chk_agent_trigger_policies_effect CHECK (effect IN ('ALLOW', 'DENY'));
            ALTER TABLE agent_trigger_policies
                ADD CONSTRAINT chk_agent_trigger_policies_identity_requires_connector CHECK (connector_identity IS NULL OR connector_name IS NOT NULL);
            ALTER TABLE agent_trigger_policies
                ADD CONSTRAINT chk_agent_trigger_policies_trigger_requires_connector CHECK (trigger_name IS NULL OR connector_name IS NOT NULL);
        </sql>

        <addUniqueConstraint tableName="agent_trigger_policies"
                             columnNames="api_key_pub_id, connector_name, connector_identity, trigger_name, effect"
                             constraintName="uq_agent_trigger_policies_composite"/>

        <createIndex tableName="agent_trigger_policies" indexName="idx_agent_trigger_policies_api_key">
            <column name="api_key_pub_id"/>
        </createIndex>

        <createIndex tableName="agent_trigger_policies" indexName="idx_agent_trigger_policies_lookup">
            <column name="api_key_pub_id"/>
            <column name="connector_name"/>
            <column name="connector_identity"/>
            <column name="trigger_name"/>
        </createIndex>
    </changeSet>

    <!-- ===================== -->
    <!-- trigger_logs          -->
    <!-- ===================== -->
    <changeSet id="create-trigger-logs-table" author="agimate">
        <createTable tableName="trigger_logs">
            <column name="id" type="BIGSERIAL" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="pub_id" type="UUID" defaultValueComputed="gen_random_uuid()">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="app_id" type="BIGINT">
                <constraints nullable="false"
                             foreignKeyName="fk_trigger_logs_app"
                             references="apps(id)"/>
            </column>
            <column name="user_pub_id" type="UUID">
                <constraints nullable="false"/>
            </column>
            <column name="trigger_id" type="TEXT"/>
            <column name="trigger_type" type="TEXT"/>
            <column name="trigger_name" type="TEXT">
                <constraints nullable="false"/>
            </column>
            <column name="trigger_source" type="TEXT"/>
            <column name="request_device_id" type="TEXT"/>
            <column name="linked_device_id" type="TEXT"/>
            <column name="occurred_at" type="TIMESTAMP"/>
            <column name="trigger_data" type="JSONB">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <createIndex tableName="trigger_logs" indexName="idx_trigger_logs_app_id">
            <column name="app_id"/>
        </createIndex>

        <createIndex tableName="trigger_logs" indexName="idx_trigger_logs_user_pub_id">
            <column name="user_pub_id"/>
        </createIndex>

        <createIndex tableName="trigger_logs" indexName="idx_trigger_logs_created_at">
            <column name="created_at" descending="true"/>
        </createIndex>
    </changeSet>

    <!-- ===================== -->
    <!-- trigger_log_agents    -->
    <!-- ===================== -->
    <changeSet id="create-trigger-log-agents-table" author="agimate">
        <createTable tableName="trigger_log_agents">
            <column name="id" type="BIGSERIAL" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="trigger_log_id" type="BIGINT">
                <constraints nullable="false"
                             foreignKeyName="fk_trigger_log_agents_trigger_log"
                             references="trigger_logs(id)"/>
            </column>
            <column name="agent_id" type="BIGINT">
                <constraints nullable="false"
                             foreignKeyName="fk_trigger_log_agents_agent"
                             references="agents(id)"/>
            </column>
            <column name="routed_to" type="TEXT">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <addUniqueConstraint tableName="trigger_log_agents"
                             columnNames="trigger_log_id, agent_id"
                             constraintName="uq_trigger_log_agents_log_id_agent_id"/>

        <createIndex tableName="trigger_log_agents" indexName="idx_trigger_log_agents_trigger_log_id">
            <column name="trigger_log_id"/>
        </createIndex>
    </changeSet>

    <!-- ===================== -->
    <!-- webhook_delivery_logs -->
    <!-- ===================== -->
    <changeSet id="create-webhook-delivery-logs-table" author="agimate">
        <createTable tableName="webhook_delivery_logs">
            <column name="id" type="BIGSERIAL" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
