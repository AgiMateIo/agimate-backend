<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
         http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.29.xsd">

    <changeSet id="create-device-auth-keys-table" author="agimate">
        <createTable tableName="device_auth_keys">
            <column name="id" type="BIGSERIAL" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="pub_id" type="UUID" defaultValueComputed="gen_random_uuid()">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="user_pub_id" type="UUID">
                <constraints nullable="false"/>
            </column>
            <column name="name" type="TEXT">
                <constraints nullable="false"/>
            </column>
            <column name="description" type="TEXT"/>
            <column name="key_hash" type="TEXT">
                <constraints nullable="false"/>
            </column>
            <column name="key_id" type="TEXT">
                <constraints nullable="false"/>
            </column>
            <column name="enabled" type="BOOLEAN" defaultValueBoolean="true">
                <constraints nullable="false"/>
            </column>
            <column name="deleted_at" type="TIMESTAMP"/>
            <column name="created_at" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <!-- Index for looking up keys by userEntity -->
        <createIndex tableName="device_auth_keys" indexName="idx_device_auth_keys_user_pub_id">
            <column name="user_pub_id"/>
        </createIndex>

        <!-- Index for authentication lookup by key ID -->
        <createIndex tableName="device_auth_keys" indexName="idx_device_auth_keys_key_id_active">
            <column name="key_id"/>
            <column name="enabled"/>
            <column name="deleted_at"/>
        </createIndex>
    </changeSet>

    <changeSet id="create-device-table" author="agimate">
        <createTable tableName="device">
            <column name="id" type="BIGSERIAL" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="device_id" type="TEXT">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="name" type="TEXT">
                <constraints nullable="false"/>
            </column>
            <column name="os" type="TEXT">
                <constraints nullable="false"/>
            </column>
            <column name="device_auth_key_id" type="BIGINT">
                <constraints nullable="true"/>
            </column>
            <column name="created_at" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <!-- Index for looking up devices by device_auth_key_id -->
        <createIndex tableName="device" indexName="idx_device_auth_key_id">
            <column name="device_auth_key_id"/>
        </createIndex>

        <!-- Foreign key to device_auth_keys table -->
        <addForeignKeyConstraint
                baseTableName="device"
                baseColumnNames="device_auth_key_id"
                constraintName="fk_device_device_auth_key"
                referencedTableName="device_auth_keys"
                referencedColumnNames="id"
                onDelete="SET NULL"/>
    </changeSet>

</databaseChangeLog>
