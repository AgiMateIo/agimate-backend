<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
         http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.29.xsd">

    <changeSet id="create-integration-credentials-table" author="agimate">
        <createTable tableName="integration_credentials">
            <column name="id" type="UUID" defaultValueComputed="uuidv7()">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="connector_code" type="TEXT">
                <constraints nullable="false"
                             foreignKeyName="fk_integration_credentials_connectors"
                             references="connectors(code)"/>
            </column>
            <column name="user_pub_id" type="UUID">
                <constraints nullable="false"/>
            </column>
            <column name="name" type="TEXT"/>
            <column name="platform_identifier" type="TEXT">
                <constraints nullable="false"/>
            </column>
            <column name="encrypted_data" type="TEXT">
                <constraints nullable="false"/>
            </column>
            <column name="webhook_secret" type="TEXT"/>
            <column name="enabled" type="BOOLEAN" defaultValueBoolean="true">
                <constraints nullable="false"/>
            </column>
            <column name="last_used_at" type="TIMESTAMP"/>
            <column name="deleted_at" type="TIMESTAMP"/>
            <column name="created_at" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <addUniqueConstraint tableName="integration_credentials"
                             columnNames="connector_code, user_pub_id, platform_identifier"
                             constraintName="uq_integration_credentials_connector_user_identifier"/>

        <createIndex tableName="integration_credentials" indexName="idx_integration_credentials_connector_code">
            <column name="connector_code"/>
        </createIndex>
    </changeSet>

</databaseChangeLog>
