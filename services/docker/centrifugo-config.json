{
  "client": {
    "token": {
      "hmac_secret_key": "change_this_secret_in_production"
    },
    "allowed_origins": ["*"]
  },
  "admin": {
    "enabled": true,
    "password": "dev_admin_password",
    "secret": "dev_admin_secret"
  },
  "http_api": {
    "key": "dev_api_key"
  },
  "log_level": "debug",
  "channel": {
    "namespaces": [
      {
        "name": "app",
        "allow_subscribe_for_client": false,
        "allow_publish_for_client": false,
        "history": {
          "max_publications": 100,
          "ttl": "600s"
        },
        "force_push_join_leave": false,
        "force_recovery": false
      },
      {
        "name": "agent",
        "allow_subscribe_for_client": false,
        "allow_publish_for_client": false,
        "history": {
          "max_publications": 100,
          "ttl": "600s"
        },
        "force_push_join_leave": false,
        "force_recovery": false
      },
      {
        "name": "user",
        "allow_subscribe_for_client": false,
        "allow_publish_for_client": false,
        "allow_tags_filter": true,
        "history": {
          "max_publications": 100,
          "ttl": "600s"
        },
        "force_push_join_leave": false,
        "force_recovery": false
      }
    ]
  }
}
