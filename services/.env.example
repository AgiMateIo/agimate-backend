# JWT Keys (ES256 - ECDSA P-256)
# Generate using the commands in backend/CLAUDE.md
# Properties: jwt.private-key, jwt.public-key
JWT_PRIVATEKEY=
JWT_PUBLICKEY=

# Google OAuth2 (for user-api)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# OAuth2 Cookie & Redirect Settings (for user-api)
# Cookie domain for refresh token (e.g., agimate.lc, .example.com)
# Property: app.oauth.cookie-domain
APP_OAUTH_COOKIE_DOMAIN=agimate.lc
# Frontend URL to redirect after OAuth2 login (without trailing hash/fragment)
# Property: app.oauth.frontend-redirect-url
APP_OAUTH_FRONTEND_REDIRECT_URL=http://www.agimate.lc:8000/login
# Comma-separated list of allowed redirect URLs for multi-domain OAuth2 support
# Property: app.oauth.allowed-redirect-urls
APP_OAUTH_ALLOWED_REDIRECT_URLS=
# AES-256 key for OAuth2 authorization-request cookies (base64-encoded 32 bytes)
# Generate using: openssl rand -base64 32
# Property: app.oauth.cookie-encryption-key
APP_OAUTH_COOKIE_ENCRYPTION_KEY=

# System content language of the installation (for control-api): ru | en
# Seeds agent presets and skills from resources/seed/<lang>/ and translates the connector catalog.
# NOT the language agents reply in — that follows the user. Presets and skills are seeded once
# (seed-only-if-missing), so changing this on an already-seeded database does not retranslate them.
# Property: app.content.language
APP_CONTENT_LANGUAGE=ru

# Secrets KEK (master key for envelope-encrypted secrets; AES-256, base64-encoded 32 bytes)
# Generate using: openssl rand -base64 32
# Property: app.secrets.encryption-key
APP_SECRETS_ENCRYPTION_KEY=
# Integration Webhook Base URL (for control-api)
# Public URL where Telegram/etc. can reach the webhook endpoint
# Property: app.integration.webhook-base-url
APP_INTEGRATION_WEBHOOK_BASE_URL=

# Platform LLM provider (system-owned free-tier fallback for agents without an LLM binding)
# is created and managed entirely by an ADMIN via POST /manage/llm-providers/platform —
# no environment variables. See docs/services/control-api-manage-llm-providers.md.

# Telegram integration mode (for control-api): webhook | polling
# Use "polling" for local development — the service will long-poll Telegram
# instead of registering a webhook. No public URL required.
# Property: app.integration.telegram.mode
APP_INTEGRATION_TELEGRAM_MODE=webhook

# Centrifugo API Key (for control-api)
# Should match api_key in docker/centrifugo-config.json
# Property: centrifugo.api-key
CENTRIFUGO_APIKEY=dev_api_key

# gRPC server for Generic Worker protocol (control-api)
# Property: grpc.server.enabled
GRPC_SERVER_ENABLED=false
# Property: grpc.server.port
GRPC_SERVER_PORT=9091
# Property: grpc.server.security.enabled — TLS on/off (must be true in production)
GRPC_SERVER_SECURITY_ENABLED=false
# Property: grpc.server.security.certificate-chain — path to PEM cert
GRPC_SERVER_SECURITY_CERTIFICATECHAIN=
# Property: grpc.server.security.private-key — path to PEM key
GRPC_SERVER_SECURITY_PRIVATEKEY=

# Worker pool authkeys (control-api). Each entry is an 80-char string:
#   prefix(4) + keyId(12) + sha256Hex(64) — e.g. wrkp<keyId><hash>
# Generate via JUnit: ./gradlew :control-api:test --tests "*WorkerAuthkeyGeneratorTest" -Dgenerate.worker.authkey=true
# The "Full key" goes to the worker (Bearer token); the "Authkey" goes here.
# Property: worker-pools.authkeys
WORKER_POOLS_AUTHKEYS_0=

# File storage for the connector file layer (control-api).
# See docs/connectors/files.md. backend: local (disk, default) | s3 (AWS S3 / MinIO).
# Property: app.files.backend
APP_FILES_BACKEND=local
# Local backend root; empty = ~/.agimate/files
# Property: app.files.local-dir
APP_FILES_LOCAL_DIR=
# --- s3 backend only. Empty endpoint = AWS; empty keys = AWS credentials chain.
# Property: app.files.bucket
APP_FILES_BUCKET=agimate-files
# Property: app.files.endpoint
APP_FILES_ENDPOINT=
# Property: app.files.region
APP_FILES_REGION=us-east-1
# Property: app.files.access-key
APP_FILES_ACCESS_KEY=
# Property: app.files.secret-key
APP_FILES_SECRET_KEY=
