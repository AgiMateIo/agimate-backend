<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="004-webhook-refactoring" author="agimate">
        <comment>Refactor webhook system to support multiple events per URL</comment>

        <!-- 1. Create event_descriptions table -->
        <createTable tableName="event_descriptions">
            <column name="id" type="BIGSERIAL">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="event_type" type="TEXT">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="title" type="TEXT">
                <constraints nullable="false"/>
            </column>
            <column name="description" type="TEXT"/>
        </createTable>

        <createIndex tableName="event_descriptions" indexName="idx_event_descriptions_event_type">
            <column name="event_type"/>
        </createIndex>

        <!-- 2. Create webhook_url_events table -->
        <createTable tableName="webhook_url_events">
            <column name="id" type="BIGSERIAL">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="webhook_url_id" type="BIGINT">
                <constraints nullable="false"/>
            </column>
            <column name="event_type" type="TEXT">
                <constraints nullable="false"/>
            </column>
            <column name="user_pub_id" type="UUID">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <!-- 3. Rename webhook_registrations to webhook_urls -->
        <renameTable oldTableName="webhook_registrations" newTableName="webhook_urls"/>

        <!-- 4. Migrate data: copy event_type from webhook_urls to webhook_url_events -->
        <sql>
            INSERT INTO webhook_url_events (webhook_url_id, event_type, user_pub_id)
            SELECT id, event_type, user_pub_id
            FROM webhook_urls
            WHERE event_type IS NOT NULL;
        </sql>

        <!-- 5. Add foreign key constraint for webhook_url_events -->
        <addForeignKeyConstraint
                baseTableName="webhook_url_events"
                baseColumnNames="webhook_url_id"
                constraintName="fk_webhook_url_events_webhook_url"
                referencedTableName="webhook_urls"
                referencedColumnNames="id"
                onDelete="CASCADE"/>

        <!-- 6. Add unique constraint and index on webhook_url_events -->
        <addUniqueConstraint
                tableName="webhook_url_events"
                columnNames="webhook_url_id, event_type"
                constraintName="unq_webhook_url_events_url_event"/>

        <createIndex tableName="webhook_url_events" indexName="idx_webhook_url_events_user_event">
            <column name="user_pub_id"/>
            <column name="event_type"/>
        </createIndex>

        <!-- 7. Drop old unique constraint on webhook_urls -->
        <sql>
            DROP INDEX IF EXISTS unq_webhook_user_event_url;
        </sql>

        <!-- 8. Drop event_type column from webhook_urls -->
        <dropColumn tableName="webhook_urls" columnName="event_type"/>

        <!-- 9. Rename foreign key column in webhook_deliveries -->
        <renameColumn tableName="webhook_deliveries"
                      oldColumnName="webhook_registration_id"
                      newColumnName="webhook_url_id"
                      columnDataType="BIGINT"/>

        <!-- 10. Drop old foreign key constraint -->
        <dropForeignKeyConstraint
                baseTableName="webhook_deliveries"
                constraintName="fk_webhook_delivery_registration"/>

        <!-- 11. Add new foreign key constraint -->
        <addForeignKeyConstraint
                baseTableName="webhook_deliveries"
                baseColumnNames="webhook_url_id"
                constraintName="fk_webhook_delivery_webhook_url"
                referencedTableName="webhook_urls"
                referencedColumnNames="id"
                onDelete="CASCADE"/>

        <!-- 12. Drop old indexes on webhook_urls -->
        <sql>
            DROP INDEX IF EXISTS idx_webhook_registrations_event_type;
            DROP INDEX IF EXISTS idx_webhook_registrations_user_event_active;
        </sql>

        <!-- 13. Rename remaining indexes on webhook_urls -->
        <sql>
            ALTER INDEX IF EXISTS idx_webhook_registrations_user_pub_id RENAME TO idx_webhook_urls_user_pub_id;
            ALTER INDEX IF EXISTS idx_webhook_registrations_enabled_deleted RENAME TO idx_webhook_urls_enabled_deleted;
        </sql>

        <!-- 14. Rename index on webhook_deliveries -->
        <sql>
            ALTER INDEX IF EXISTS idx_webhook_deliveries_registration_id RENAME TO idx_webhook_deliveries_webhook_url_id;
        </sql>

        <rollback>
            <!-- Rollback in reverse order -->
            <sql>ALTER INDEX IF EXISTS idx_webhook_deliveries_webhook_url_id RENAME TO idx_webhook_deliveries_registration_id;</sql>
            <sql>ALTER INDEX IF EXISTS idx_webhook_urls_enabled_deleted RENAME TO idx_webhook_registrations_enabled_deleted;</sql>
            <sql>ALTER INDEX IF EXISTS idx_webhook_urls_user_pub_id RENAME TO idx_webhook_registrations_user_pub_id;</sql>

            <sql>
                CREATE INDEX idx_webhook_registrations_user_event_active ON webhook_urls (user_pub_id, event_type, deleted_at);
                CREATE INDEX idx_webhook_registrations_event_type ON webhook_urls (event_type);
            </sql>

            <dropForeignKeyConstraint baseTableName="webhook_deliveries" constraintName="fk_webhook_delivery_webhook_url"/>
            <addForeignKeyConstraint
                    baseTableName="webhook_deliveries"
                    baseColumnNames="webhook_url_id"
                    constraintName="fk_webhook_delivery_registration"
                    referencedTableName="webhook_urls"
                    referencedColumnNames="id"
                    onDelete="CASCADE"/>

            <renameColumn tableName="webhook_deliveries" oldColumnName="webhook_url_id" newColumnName="webhook_registration_id" columnDataType="BIGINT"/>

            <addColumn tableName="webhook_urls">
                <column name="event_type" type="TEXT"/>
            </addColumn>

            <sql>
                UPDATE webhook_urls w
                SET event_type = (
                    SELECT event_type
                    FROM webhook_url_events e
                    WHERE e.webhook_url_id = w.id
                    LIMIT 1
                );
            </sql>

            <sql>
                CREATE UNIQUE INDEX unq_webhook_user_event_url
                ON webhook_urls(user_pub_id, event_type, url)
                WHERE deleted_at IS NULL;
            </sql>

            <dropTable tableName="webhook_url_events"/>
            <dropTable tableName="event_descriptions"/>

            <renameTable oldTableName="webhook_urls" newTableName="webhook_registrations"/>
        </rollback>
    </changeSet>

</databaseChangeLog>
